{
  "name": "fisture",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply fisture-db --local",
    "db:migrate:prod": "wrangler d1 migrations apply fisture-db --remote",
    "db:studio": "drizzle-kit studio",
    "cf:dev": "wrangler pages dev ./dist",
    "cf:deploy": "wrangler pages deploy ./dist",
    "sync:check": "node scripts/sync-check.mjs",
    "test": "npm run test:discover && vitest run",
    "test:watch": "vitest",
    "test:discover": "node scripts/check-test-discovery.mjs",
    "hooks:install": "git config core.hooksPath .githooks && git config commit.template .gitmessage",
    "typecheck": "astro check",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:smoke": "node scripts/production-smoke.mjs",
    "check": "npm run typecheck && npm run test:discover && npm run test:coverage && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.0.0",
    "@astrojs/react": "^4.0.0",
    "@astrojs/tailwind": "^6.0.0",
    "arctic": "^3.7.0",
    "astro": "^5.0.0",
    "drizzle-orm": "^0.45.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@cloudflare/workers-types": "^4.20241127.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "drizzle-kit": "^0.31.11",
    "miniflare": "^3.20250718.3",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.7",
    "wrangler": "^3.90.0"
  }
}
