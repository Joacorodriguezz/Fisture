# Cloudflare
CLOUDFLARE_ACCOUNT_ID=your_account_id
CLOUDFLARE_API_TOKEN=your_api_token
D1_DATABASE_ID=your_d1_database_id

# OAuth - Google
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# OAuth - Microsoft
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret

# OAuth - Apple
APPLE_CLIENT_ID=your_apple_client_id
APPLE_TEAM_ID=your_apple_team_id
APPLE_KEY_ID=your_apple_key_id
APPLE_PRIVATE_KEY=your_apple_private_key

# Cifrado de tokens OAuth en reposo (docs/15): 32 bytes aleatorios en base64.
# Generar con: openssl rand -base64 32. En producción y preview va como secret de Pages.
TOKEN_ENCRYPTION_KEY=your_base64_32_byte_key
# Solo al rotar la clave: la anterior (solo descifra)
# TOKEN_ENCRYPTION_KEY_PREVIOUS=

# API Football (https://dashboard.api-football.com)
API_FOOTBALL_KEY=your_api_football_key

# football-data.org (opcional: el sync usa ESPN, que no requiere API key)
FOOTBALL_DATA_API_KEY=your_football_data_api_key

# App
PUBLIC_APP_URL=http://localhost:4321
