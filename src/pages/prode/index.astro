---
// /prode (docs/37 D10): sin sesión presenta el juego; con sesión, tus grupos, lo que te falta
// pronosticar y crear o unirte a un grupo.
import Layout from "../../layouts/Layout.astro";
import Volanta from "../../components/tribuna/Volanta.astro";
import Titular from "../../components/tribuna/Titular.astro";
import Bajada from "../../components/tribuna/Bajada.astro";
import Escudo from "../../components/tribuna/Escudo.astro";
import Reglamento from "../../components/prode/Reglamento.astro";
import CrearGrupo from "../../components/islands/prode/CrearGrupo";
import { createDb } from "../../lib/db";
import { getLigasPublicas } from "../../lib/db/queries";
import { loginHref } from "../../lib/auth/guards";
import { fechaCorta, hora } from "../../lib/format";
import { logoDeCompetencia } from "../../lib/logos-competencias";
import { misGrupos, pendientesDe, tablasDeGrupos } from "../../lib/prode/repo";
import { ordenarTabla } from "../../lib/prode/reglas";
import "../../styles/prode.css";

const user = Astro.locals.user;
const DB = Astro.locals.runtime.env.DB;
const ahora = new Date();

const grupos = user ? await misGrupos(DB, user.id) : [];
const [tablas, pendientes, ligas] = user
  ? await Promise.all([
      tablasDeGrupos(DB, grupos),
      pendientesDe(DB, user.id, grupos.map((g) => g.leagueId), ahora),
      getLigasPublicas(createDb(DB)),
    ])
  : [new Map(), [], []];

const tarjetas = grupos.map((g) => {
  const tabla = ordenarTabla(tablas.get(g.id) ?? [], user?.id ?? "");
  const yo = tabla.find((f) => f.esVos);
  const faltan = pendientes.filter((p) => p.leagueId === g.leagueId).length;
  return { ...g, posicion: yo?.posicion ?? null, puntos: yo?.puntos ?? 0, faltan, logo: logoDeCompetencia(g.ligaExternalId, g.ligaLogo) };
});

// El primero que cierra, para el aviso de arriba (llega con el grupo de su competencia)
const primero = pendientes[0];
const grupoDelPrimero = primero ? grupos.find((g) => g.leagueId === primero.leagueId) : undefined;
const cuandoCierra = primero
  ? `${fechaCorta(primero.dateTime) === fechaCorta(ahora) ? "hoy" : `el ${fechaCorta(primero.dateTime).toLowerCase()}`} a las ${hora(primero.dateTime)}`
  : "";

const aviso = { salida: "Saliste del grupo.", borrado: "Borraste el grupo." }[Astro.url.searchParams.get("aviso") ?? ""] ?? null;
const errorCodigo = Astro.url.searchParams.get("error") === "codigo";
const ligasForm = ligas.map((l) => ({ id: l.id, nombre: l.name }));
---

<Layout
  title="Prode con amigos: pronosticá los partidos - FISTURE"
  pagina={9}
  descripcion="Armá el prode con tus amigos: pronosticá los partidos de la Liga Profesional, la Libertadores y más. Fisture suma los puntos y arma la tabla solo."
>
  <div class="pr-pagina pr-pagina--ancha">
    <div class="pr-cabeza">
      <Volanta tono="rojo">Jugá con tus amigos</Volanta>
      <Titular nivel="1">Prode</Titular>
      {!user && (
        <Bajada>
          Pronosticá los partidos de la Liga Profesional, la Libertadores y más con tu grupo. Fisture suma los puntos
          cuando terminan los partidos y arma la tabla sola.
        </Bajada>
      )}
    </div>

    {aviso && <p class="pr-aviso" role="status">{aviso}</p>}

    {!user ? (
      <>
        <section aria-labelledby="como-se-juega" class="pr-seccion">
          <h2 id="como-se-juega" class="tb-titular tb-titular--3">Cómo se juega</h2>
          <ol class="pr-pasos">
            <li><b>Armá el grupo</b>Elegí la competencia y ponele nombre. Te damos un link para mandar por WhatsApp.</li>
            <li><b>Pronosticá</b>Cargá el resultado de cada partido hasta que empieza. Lo podés cambiar las veces que quieras.</li>
            <li><b>Mirá la tabla</b>Cuando termina el partido sumás puntos. Lo que puso cada uno se ve recién cuando arranca.</li>
          </ol>
          <Reglamento />
        </section>
        <div class="pr-acciones">
          <div class="pr-caja">
            <h2>Empezá a jugar</h2>
            <p class="pr-texto">Ingresá con tu cuenta de Google o Microsoft. Es gratis.</p>
            <a class="tb-boton tb-boton--primario" href={loginHref("/prode")} style="text-align:center;text-decoration:none">Ingresá para jugar</a>
          </div>
          <form class="pr-caja" action="/prode/unirse" method="get">
            <h2>¿Te pasaron un código?</h2>
            <div class="pr-campo pr-codigo-campo">
              <label for="codigo-anonimo">Código del grupo</label>
              <input id="codigo-anonimo" name="codigo" type="text" autocomplete="off" autocapitalize="characters" spellcheck="false" maxlength="12" placeholder="ABCD EFGH" required aria-invalid={errorCodigo ? "true" : undefined} aria-describedby="codigo-anonimo-ayuda" />
              <small id="codigo-anonimo-ayuda" class={errorCodigo ? "tb-error" : undefined}>{errorCodigo ? "Ese código no es válido: son 8 letras y números." : "Son 8 letras y números."}</small>
            </div>
            <button type="submit" class="tb-boton">Ver el grupo</button>
          </form>
        </div>
      </>
    ) : (
      <>
        {primero && grupoDelPrimero && (
          <div class="tb-recuadro tb-recuadro--sombra" role="region" aria-labelledby="pendientes-titulo">
            <h2 id="pendientes-titulo" class="tb-recuadro__titulo">
              {pendientes.length === 1 ? "Te falta 1 pronóstico" : `Te faltan ${pendientes.length} pronósticos`}
            </h2>
            <div class="tb-recuadro__cuerpo pr-botones" style="justify-content:space-between">
              <span>En los próximos 7 días. El primero cierra {cuandoCierra}.</span>
              <a class="tb-boton tb-boton--tinta" href={`/prode/${grupoDelPrimero.id}`}>Cargar pronósticos</a>
            </div>
          </div>
        )}

        {tarjetas.length > 0 ? (
          <section aria-labelledby="tus-grupos" style="display:flex;flex-direction:column;gap:16px">
            <h2 id="tus-grupos" class="tb-barra tb-barra--rojo">
              <span>Tus grupos</span>
              <span class="tb-barra__extra">{tarjetas.length === 1 ? "1 grupo" : `${tarjetas.length} grupos`}</span>
            </h2>
            <ul class="pr-grupos">
              {tarjetas.map((g) => (
                <li>
                  <a class="pr-tarjeta" href={`/prode/${g.id}`}>
                    <span class="pr-liga tb-meta">
                      {g.logo && <Escudo src={g.logo} nombre={g.ligaNombre} size={24} pad={2} />}
                      {g.ligaNombre}
                    </span>
                    <h3>{g.name}</h3>
                    {g.faltan > 0 && <span class="pr-falta">{g.faltan === 1 ? "Te falta 1" : `Te faltan ${g.faltan}`}</span>}
                    <span class="pr-tarjeta-datos">
                      <span class="pr-cifra">{g.posicion ?? "–"}<small>{g.posicion ? `.º de ${g.miembros}` : "Sin tabla"}</small></span>
                      <span class="pr-cifra">{g.puntos}<small>{g.puntos === 1 ? "punto" : "puntos"}</small></span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ) : (
          <div class="tb-vacio">
            <p style="margin:0;max-width:52ch"><b>Todavía no estás en ningún grupo.</b> Creá uno y mandale el link a tu gente, o sumate con el código que te pasaron.</p>
          </div>
        )}

        <div class="pr-acciones">
          <CrearGrupo client:visible ligas={ligasForm} />
          <form class="pr-caja" action="/prode/unirse" method="get">
            <h3>Unirme con un código</h3>
            <div class="pr-campo pr-codigo-campo">
              <label for="codigo">Código del grupo</label>
              <input id="codigo" name="codigo" type="text" autocomplete="off" autocapitalize="characters" spellcheck="false" maxlength="12" placeholder="ABCD EFGH" required aria-invalid={errorCodigo ? "true" : undefined} aria-describedby="codigo-ayuda" />
              <small id="codigo-ayuda" class={errorCodigo ? "tb-error" : undefined}>{errorCodigo ? "Ese código no es válido: son 8 letras y números." : "Te lo pasa quien organiza. También sirve el link."}</small>
            </div>
            <button type="submit" class="tb-boton">Ver el grupo</button>
          </form>
        </div>

        <section aria-labelledby="reglas" style="display:flex;flex-direction:column;gap:12px">
          <h2 id="reglas" class="tb-titular tb-titular--3">Reglamento</h2>
          <Reglamento />
          <p class="pr-nota">
            Se puede pronosticar cada partido hasta que empieza. Tu pronóstico vale para todos tus grupos de esa
            competencia. Los puntos se suman cuando cargamos el resultado, a la mañana siguiente del partido. Desempata
            quien tenga más resultados exactos y después más aciertos.
          </p>
        </section>
      </>
    )}
  </div>
</Layout>
