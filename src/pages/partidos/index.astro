---
import Layout from "../../layouts/Layout.astro";
import PartidoCard from "../../components/PartidoCard.astro";
import { createDb } from "../../lib/db";
import { getUpcomingMatches } from "../../lib/db/queries";
import { calendarSyncs } from "../../../drizzle/schema";
import { eq, and, inArray } from "drizzle-orm";

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect("/login");
}

const db = createDb(Astro.locals.runtime.env.DB);
const matchesData = await getUpcomingMatches(db, user.id, 30);

// Obtener estado de sync para cada partido
const matchIds = matchesData.map((m) => m.match.id);
let syncMap = new Map<string, string>();

if (matchIds.length > 0) {
  const syncs = await db
    .select()
    .from(calendarSyncs)
    .where(
      and(
        eq(calendarSyncs.userId, user.id),
        inArray(calendarSyncs.matchId, matchIds)
      )
    );

  syncMap = new Map(syncs.map((s) => [s.matchId, s.status || "pending"]));
}

// Agrupar partidos por fecha
const matchesByDate = new Map<string, typeof matchesData>();
matchesData.forEach((m) => {
  const dateKey = new Date(m.match.dateTime).toLocaleDateString("es-AR", {
    weekday: "long",
    day: "numeric",
    month: "long",
  });
  if (!matchesByDate.has(dateKey)) {
    matchesByDate.set(dateKey, []);
  }
  matchesByDate.get(dateKey)!.push(m);
});
---

<Layout title="Próximos Partidos - FISTURE">
  <div class="max-w-4xl mx-auto px-4 py-8">
    <div class="flex justify-between items-center mb-8">
      <h1 class="text-3xl font-bold">Próximos Partidos</h1>

      {matchesData.length > 0 && (
        <a
          href="/api/calendario/download"
          class="btn btn-secondary btn-sm"
          download
        >
          <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          Descargar todos (.ics)
        </a>
      )}
    </div>

    {matchesData.length === 0 ? (
      <div class="text-center py-12 bg-white rounded-lg shadow">
        <div class="text-5xl mb-4">📅</div>
        <p class="text-gray-600 mb-4">No hay partidos próximos</p>
        <p class="text-gray-500 text-sm mb-6">
          Agregá equipos para ver sus próximos partidos
        </p>
        <a href="/equipos/buscar" class="btn btn-primary">
          Buscar equipos
        </a>
      </div>
    ) : (
      <div class="space-y-8">
        {Array.from(matchesByDate.entries()).map(([dateKey, matches]) => (
          <div>
            <h2 class="text-lg font-medium text-gray-700 mb-4 capitalize sticky top-16 bg-gray-50 py-2 z-10">
              {dateKey}
            </h2>
            <div class="space-y-4">
              {matches.map((m) => (
                <PartidoCard
                  match={m.match}
                  homeTeam={m.homeTeam}
                  awayTeam={m.awayTeam}
                  league={m.league}
                  provider={user.provider}
                  syncStatus={syncMap.get(m.match.id)}
                />
              ))}
            </div>
          </div>
        ))}
      </div>
    )}
  </div>
</Layout>
