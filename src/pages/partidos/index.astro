---
import Layout from "../../layouts/Layout.astro";
import Volanta from "../../components/tribuna/Volanta.astro";
import Titular from "../../components/tribuna/Titular.astro";
import CabezalSeccion from "../../components/tribuna/CabezalSeccion.astro";
import BarraSeccion from "../../components/tribuna/BarraSeccion.astro";
import Escudo from "../../components/tribuna/Escudo.astro";
import SincronizarPartido from "../../components/islands/SincronizarPartido";
import { createDb } from "../../lib/db";
import { getUpcomingMatches, getSyncStates } from "../../lib/db/queries";
import { asc, eq } from "drizzle-orm";
import { teams, userTeams } from "../../../drizzle/schema";
import { fechaLarga, hora } from "../../lib/format";
import { chipStyleCss } from "../../lib/chip-style";

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect("/login");
}

const db = createDb(Astro.locals.runtime.env.DB);

const seguidos = await db
  .select({ id: teams.id, name: teams.name })
  .from(userTeams)
  .innerJoin(teams, eq(userTeams.teamId, teams.id))
  .where(eq(userTeams.userId, user.id))
  .orderBy(asc(teams.name));

// Filtro por equipo: solo acepta equipos que el usuario sigue
const equipoParam = Astro.url.searchParams.get("equipo");
const equipo = seguidos.find((t) => t.id === equipoParam)?.id ?? null;

const partidos = await getUpcomingMatches(db, user.id, 60, equipo ?? undefined);
const estados = await getSyncStates(db, user.id, partidos.map((m) => m.match.id));

// Agrupar por día, manteniendo el orden cronológico
const dias = new Map<string, typeof partidos>();
for (const m of partidos) {
  const dia = fechaLarga(m.match.dateTime);
  if (!dias.has(dia)) dias.set(dia, []);
  dias.get(dia)!.push(m);
}
const grupos = Array.from(dias.entries()).map(([dia, items]) => ({ dia, items }));
---

<Layout title="Próximos Partidos - FISTURE" pagina={5}>
  <div style="display:flex;flex-direction:column;gap:28px">
    <CabezalSeccion firma="Tu fixture">la jornada está aquí</CabezalSeccion>

    <div style="display:flex;flex-direction:column;align-items:flex-start;gap:12px">
      <Volanta tono="tinta">Lo que viene</Volanta>
      <Titular nivel="1">PARTIDO POR PARTIDO</Titular>
    </div>

    <div style="display:flex;flex-wrap:wrap;gap:8px">
      <a href="/partidos" style={chipStyleCss(equipo === null)}>Todos</a>
      {seguidos.map((t) => (
        <a href={`/partidos?equipo=${t.id}`} style={chipStyleCss(equipo === t.id)}>{t.name}</a>
      ))}
    </div>

    {grupos.length === 0 ? (
      <div style="background:var(--papel-2);padding:40px 32px;font:400 17px/27px var(--font-texto);text-align:center">
        No hay partidos próximos.{" "}
        <a href="/ligas" style="font-weight:700">Seguí un equipo</a> para armar tu fixture.
      </div>
    ) : (
      <div style="display:flex;flex-direction:column;gap:28px">
        {grupos.map((g) => (
          <div style="display:flex;flex-direction:column">
            <BarraSeccion tono="rojo" extra={g.items.length === 1 ? "1 partido" : `${g.items.length} partidos`}>
              {g.dia}
            </BarraSeccion>
            {g.items.map((m) => {
              const estado = estados.get(m.match.id);
              return (
                <div style="display:flex;flex-wrap:wrap;align-items:center;gap:12px 16px;padding:16px 12px;border-bottom:1px solid var(--linea)">
                  <a
                    href={`/partidos/${m.match.id}`}
                    style="flex:1;min-width:240px;display:grid;grid-template-columns:96px minmax(0,1fr);align-items:center;gap:16px;color:var(--tinta);text-decoration:none"
                  >
                    <span style="font:400 40px/1 var(--font-titular)">{hora(m.match.dateTime)}</span>
                    <div style="min-width:0;display:flex;flex-direction:column;gap:4px">
                      <span style="font:700 12px/16px var(--font-rotulo);letter-spacing:.06em;text-transform:uppercase;color:var(--rojo)">
                        {m.league.name}{m.match.round ? ` · ${m.match.round}` : ""}
                      </span>
                      <span style="display:flex;flex-wrap:wrap;align-items:center;gap:10px;font:400 26px/1.05 var(--font-titular);text-transform:uppercase">
                        <Escudo src={m.homeTeam.logo} nombre={m.homeTeam.name} sigla={m.homeTeam.shortName} size={40} />
                        <span>{m.homeTeam.name}</span>
                        <span style="color:var(--tinta-suave)">vs</span>
                        <Escudo src={m.awayTeam.logo} nombre={m.awayTeam.name} sigla={m.awayTeam.shortName} size={40} />
                        <span>{m.awayTeam.name}</span>
                      </span>
                      <span style="font:400 14px/19px var(--font-texto);color:var(--tinta-suave)">
                        {m.match.venue ?? "Sede a confirmar"}
                      </span>
                    </div>
                  </a>
                  <SincronizarPartido
                    client:load
                    matchId={m.match.id}
                    status={estado?.status ?? null}
                    errorMessage={estado?.errorMessage ?? null}
                  />
                </div>
              );
            })}
          </div>
        ))}
      </div>
    )}
  </div>
</Layout>
