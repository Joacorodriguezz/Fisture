---
import Layout from "../../layouts/Layout.astro";
import Volanta from "../../components/tribuna/Volanta.astro";
import Titular from "../../components/tribuna/Titular.astro";
import CabezalSeccion from "../../components/tribuna/CabezalSeccion.astro";
import BarraSeccion from "../../components/tribuna/BarraSeccion.astro";
import Escudo from "../../components/tribuna/Escudo.astro";
import SincronizarPartido from "../../components/islands/SincronizarPartido";
import { createDb } from "../../lib/db";
import { getUpcomingMatches, getMatchesInRange, getSyncStates } from "../../lib/db/queries";
import { loginHref } from "../../lib/auth/guards";
import { asc, eq } from "drizzle-orm";
import { teams, userTeams } from "../../../drizzle/schema";
import { fechaLarga, hora } from "../../lib/format";

// Página pública. Con sesión: próximos partidos de tus equipos. Sin sesión: próximos partidos de todas las ligas.
const user = Astro.locals.user;

const db = createDb(Astro.locals.runtime.env.DB);

const seguidos = user
  ? await db
      .select({ id: teams.id, name: teams.name })
      .from(userTeams)
      .innerJoin(teams, eq(userTeams.teamId, teams.id))
      .where(eq(userTeams.userId, user.id))
      .orderBy(asc(teams.name))
  : [];

// Filtro por equipo: solo acepta equipos que el usuario sigue
const equipoParam = Astro.url.searchParams.get("equipo");
const equipo = seguidos.find((t) => t.id === equipoParam)?.id ?? null;

const DIAS_PUBLICOS = 14;
const partidos = user
  ? await getUpcomingMatches(db, user.id, 60, equipo ?? undefined)
  : (await getMatchesInRange(db, new Date(), new Date(Date.now() + DIAS_PUBLICOS * 24 * 60 * 60 * 1000))).slice(0, 60);
const estados = user
  ? await getSyncStates(db, user.id, partidos.map((m) => m.match.id))
  : new Map<string, { status: string; errorMessage: string | null }>();

// Agrupar por día, manteniendo el orden cronológico
const dias = new Map<string, typeof partidos>();
for (const m of partidos) {
  const dia = fechaLarga(m.match.dateTime);
  if (!dias.has(dia)) dias.set(dia, []);
  dias.get(dia)!.push(m);
}

// "Hoy" y "Mañana" delante de la fecha para ubicarse rápido
const ahora = Date.now();
const hoyTxt = fechaLarga(new Date(ahora));
const mananaTxt = fechaLarga(new Date(ahora + 24 * 60 * 60 * 1000));
const prefijo = (dia: string) => (dia === hoyTxt ? "Hoy · " : dia === mananaTxt ? "Mañana · " : "");
const grupos = Array.from(dias.entries()).map(([dia, items]) => ({ dia, etiqueta: `${prefijo(dia)}${dia}`, items }));
---

<Layout title="Próximos partidos - FISTURE" pagina={5}>
  <div style="display:flex;flex-direction:column;gap:28px">
    <CabezalSeccion firma="Tu fixture">la jornada está aquí</CabezalSeccion>

    <div style="display:flex;flex-direction:column;align-items:flex-start;gap:12px">
      <Volanta tono="tinta">Lo que viene</Volanta>
      <Titular nivel="1">PARTIDO POR PARTIDO</Titular>
    </div>

    {!user && (
      <p style="margin:0;font:400 17px/27px var(--font-texto);color:var(--tinta-suave)">
        Próximos {DIAS_PUBLICOS} días en todas las ligas.{" "}
        <a href={loginHref("/partidos")}>Iniciá sesión</a> para ver solo los partidos de tus equipos y agregarlos a tu calendario.
      </p>
    )}

    {user && (
    <div class="pm-chips" style="display:flex;flex-wrap:wrap;gap:8px">
      <a href="/partidos" aria-current={equipo === null ? "true" : undefined} className={equipo === null ? "tb-chip tb-chip--activo" : "tb-chip"}>Todos</a>
      {seguidos.map((t) => (
        <a href={`/partidos?equipo=${t.id}`} aria-current={equipo === t.id ? "true" : undefined} className={equipo === t.id ? "tb-chip tb-chip--activo" : "tb-chip"}>{t.name}</a>
      ))}
    </div>
    )}

    {grupos.length === 0 ? (
      <div class="tb-vacio">
        <span>
          {!user
            ? "No hay partidos cargados para los próximos días."
            : equipo
            ? "Este equipo no tiene partidos próximos."
            : seguidos.length === 0
              ? "Todavía no seguís ningún equipo."
              : "No hay partidos próximos para tus equipos."}
        </span>
        <a href={equipo ? "/partidos" : "/ligas"} class="tb-boton tb-boton--primario" style="text-decoration:none">
          {equipo ? "Ver todos los partidos" : "Elegir equipos"}
        </a>
      </div>
    ) : (
      <div style="display:flex;flex-direction:column;gap:28px">
        {grupos.map((g) => (
          <div class="pm-grupo" style="display:flex;flex-direction:column">
            <BarraSeccion tono="rojo" extra={g.items.length === 1 ? "1 partido" : `${g.items.length} partidos`}>
              {g.etiqueta}
            </BarraSeccion>
            {g.items.map((m) => {
              const estado = estados.get(m.match.id);
              return (
                <div class="pm-fila" style="display:flex;flex-wrap:wrap;align-items:center;gap:12px 16px;padding:16px 12px;border-bottom:1px solid var(--linea)">
                  <a
                    href={`/partidos/${m.match.id}`}
                    class="pm-enlace" style="flex:1;min-width:240px;display:grid;grid-template-columns:96px minmax(0,1fr);align-items:center;gap:16px;color:var(--tinta);text-decoration:none"
                  >
                    <span class="pm-hora" style="font:400 40px/1 var(--font-titular)">{hora(m.match.dateTime)}</span>
                    <div style="min-width:0;display:flex;flex-direction:column;gap:4px">
                      <span style="font:700 13px/16px var(--font-rotulo);letter-spacing:.06em;text-transform:uppercase;color:var(--rojo)">
                        {m.league.name}{m.match.round ? ` · ${m.match.round}` : ""}
                      </span>
                      <span class="pm-equipos" style="display:flex;flex-wrap:wrap;align-items:center;gap:10px;font:400 26px/1.05 var(--font-titular);text-transform:uppercase">
                        <Escudo src={m.homeTeam.logo} nombre={m.homeTeam.name} sigla={m.homeTeam.shortName} size={40} />
                        <span>{m.homeTeam.name}</span>
                        <span class="pm-vs" style="color:var(--tinta-suave)">vs</span>
                        <Escudo src={m.awayTeam.logo} nombre={m.awayTeam.name} sigla={m.awayTeam.shortName} size={40} />
                        <span>{m.awayTeam.name}</span>
                      </span>
                      <span style="font:400 14px/19px var(--font-texto);color:var(--tinta-suave)">
                        {m.match.venue ?? "Sede a confirmar"}
                      </span>
                    </div>
                  </a>
                  <SincronizarPartido
                    client:visible
                    anonimo={!user}
                    matchId={m.match.id}
                    status={estado?.status ?? null}
                    errorMessage={estado?.errorMessage ?? null}
                  />
                </div>
              );
            })}
          </div>
        ))}
      </div>
    )}
  </div>
</Layout>
