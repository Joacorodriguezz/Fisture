---
import Layout from "../layouts/Layout.astro";
import Volanta from "../components/tribuna/Volanta.astro";
import Titular from "../components/tribuna/Titular.astro";
import Bajada from "../components/tribuna/Bajada.astro";
import { safeNext } from "../lib/auth/guards";

// A dónde volver después de loguearse (solo rutas internas seguras)
const next = safeNext(Astro.url.searchParams.get("next"));

if (Astro.locals.user) {
  return Astro.redirect(next ?? "/ligas");
}

// Mensajes según el código que devuelve el callback de OAuth (/api/auth/callback/[provider])
const mensajesError: Record<string, string> = {
  access_denied: "Cancelaste el permiso. Si fue sin querer, volvé a intentar y aceptalo.",
  invalid_state: "La sesión de inicio expiró. Volvé a intentar.",
  missing_params: "Falta información del proveedor. Volvé a intentar.",
  unsupported_provider: "Ese proveedor no está disponible por ahora.",
  oauth_failed: "No pudimos conectar con tu cuenta. Probá de nuevo en un momento.",
};
const codigoError = Astro.url.searchParams.get("error");
const error = codigoError ? mensajesError[codigoError] ?? "No pudimos iniciar sesión. Probá de nuevo." : null;

const opciones = [
  {
    href: `/api/auth/login/google${next ? `?next=${encodeURIComponent(next)}` : ""}`,
    label: "Google",
    detalle: "Crea los eventos en tu Google Calendar automáticamente",
  },
  {
    href: `/api/auth/login/microsoft${next ? `?next=${encodeURIComponent(next)}` : ""}`,
    label: "Microsoft",
    detalle: "Crea los eventos en Outlook automáticamente",
  },
];
---

<Layout title="Iniciar sesión - FISTURE" showNavbar={false}>
  <div style="max-width:480px;margin:0 auto;display:flex;flex-direction:column;gap:20px;padding:24px 0">
    <a href={next ?? "/"} class="tb-volver">← Volver</a>
    <Volanta tono="tinta">Iniciá sesión</Volanta>
    <Titular nivel="1">ENTRÁ A LA CANCHA</Titular>
    <Bajada>Usá la cuenta del calendario donde querés ver los partidos.</Bajada>

    {error && (
      <div style="background:var(--rojo-fondo);color:var(--on-rojo);padding:12px 16px;font:600 15px/20px var(--font-rotulo);letter-spacing:.02em">
        {error}
      </div>
    )}

    <div class="tb-permiso">
      <b>Qué permiso te pedimos</b>
      <span>Permiso para crear y editar eventos en tu calendario. Lo usamos solo para los partidos que vos elijas.</span>
    </div>

    <p style="font:400 14px/19px var(--font-texto);color:var(--tinta-suave)">
      Al continuar aceptás las <a href="/terminos">Condiciones del Servicio</a> y la <a href="/privacidad">Política de Privacidad</a>.
    </p>

    <div style="display:flex;flex-direction:column;gap:12px;margin-top:8px">
      {opciones.map((o) => (
        <a href={o.href} class="tb-opcion">
          <span style="display:flex;flex-direction:column;gap:2px">
            <span style="font:700 17px/20px var(--font-rotulo);letter-spacing:.04em;text-transform:uppercase">Continuar con {o.label}</span>
            <span style="font:400 14px/19px var(--font-texto);color:var(--tinta-suave)">{o.detalle}</span>
          </span>
          <span style="font:700 20px/1 var(--font-rotulo)">→</span>
        </a>
      ))}
    </div>
  </div>
</Layout>
