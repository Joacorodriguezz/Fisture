---
import Layout from "../layouts/Layout.astro";
import Volanta from "../components/tribuna/Volanta.astro";
import Titular from "../components/tribuna/Titular.astro";
import Boton from "../components/tribuna/Boton.astro";
import BarraSeccion from "../components/tribuna/BarraSeccion.astro";
import Segmentado from "../components/islands/Segmentado";
import { createDb } from "../lib/db";
import { getPreferences } from "../lib/db/preferences";
import { providerLabel } from "../lib/format";

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect("/login");
}

const prefs = await getPreferences(createDb(Astro.locals.runtime.env.DB), user.id);
const nombre = user.name?.trim() || user.email.split("@")[0];
const inicial = nombre.charAt(0).toUpperCase();

const siNo = [
  { label: "Sí", value: true },
  { label: "No", value: false },
];

const preferencias = [
  {
    label: "Aviso 1 hora antes",
    detalle: "Notificación en tu calendario",
    campo: "reminder60",
    valor: prefs.reminder60,
    opciones: siNo,
    aplicarTema: false,
  },
  {
    label: "Aviso 15 minutos antes",
    detalle: "Notificación en tu calendario",
    campo: "reminder15",
    valor: prefs.reminder15,
    opciones: siNo,
    aplicarTema: false,
  },
  {
    label: "Edición",
    detalle: "Papel de día o nocturna",
    campo: "theme",
    valor: prefs.theme,
    opciones: [
      { label: "Papel", value: "papel" },
      { label: "Nocturna", value: "nocturna" },
    ],
    aplicarTema: true,
  },
];
---

<Layout title="Configuración - FISTURE" pagina={8} noindex>
  <div style="max-width:760px;display:flex;flex-direction:column;gap:32px">
    <div style="display:flex;flex-direction:column;align-items:flex-start;gap:12px">
      <Volanta tono="tinta">Configuración</Volanta>
      <Titular nivel="1">TU CUENTA</Titular>
    </div>

    <div style="display:flex;flex-direction:column">
      <BarraSeccion tono="tinta">Cuenta</BarraSeccion>
      <div class="cf-cuenta" style="display:flex;flex-wrap:wrap;align-items:center;gap:16px;padding:16px 12px;border-bottom:1px solid var(--linea)">
        <div style="flex:none;width:56px;height:56px;background:var(--rojo-fondo);color:var(--on-rojo);display:flex;align-items:center;justify-content:center;font:400 28px/1 var(--font-titular)">
          {inicial}
        </div>
        <div style="flex:1;min-width:200px;display:flex;flex-direction:column;gap:2px">
          <span style="font:700 17px/20px var(--font-rotulo);text-transform:uppercase">{nombre}</span>
          <span style="font:400 14px/19px var(--font-texto);color:var(--tinta-suave)">
            {user.email} · {providerLabel(user.provider)}
          </span>
        </div>
        <Boton href="/api/auth/logout">Cerrar sesión</Boton>
      </div>
    </div>

    <div style="display:flex;flex-direction:column">
      <BarraSeccion tono="tinta">Preferencias</BarraSeccion>
      {preferencias.map((p) => (
        <div class="cf-pref" style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:12px 16px;padding:16px 12px;border-bottom:1px solid var(--linea)">
          <div style="flex:1;min-width:220px;display:flex;flex-direction:column;gap:2px">
            <span style="font:700 17px/20px var(--font-rotulo);text-transform:uppercase">{p.label}</span>
            <span style="font:400 14px/19px var(--font-texto);color:var(--tinta-suave)">{p.detalle}</span>
          </div>
          <Segmentado
            client:load
            ariaLabel={p.label}
            opciones={p.opciones}
            valor={p.valor}
            endpoint="/api/preferencias"
            campo={p.campo}
            aplicarTema={p.aplicarTema}
          />
        </div>
      ))}
    </div>
  </div>
</Layout>
