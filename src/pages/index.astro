---
import Layout from "../layouts/Layout.astro";
import Volanta from "../components/tribuna/Volanta.astro";
import Titular from "../components/tribuna/Titular.astro";
import Bajada from "../components/tribuna/Bajada.astro";
import Boton from "../components/tribuna/Boton.astro";
import Sello from "../components/tribuna/Sello.astro";
import { jsonLdSitio } from "../lib/seo";

if (Astro.locals.user) {
  return Astro.redirect("/ligas");
}

// Tras borrar la cuenta, DELETE /api/cuenta lleva acá con ?cuenta=eliminada
const cuentaEliminada = Astro.url.searchParams.get("cuenta") === "eliminada";

const pasos = [
  {
    numero: "01",
    titulo: "Sync automático",
    texto: "Los partidos aparecen en tu Google Calendar o Outlook. Si cambia el horario, el evento se actualiza solo.",
  },
  {
    numero: "02",
    titulo: "Ligas y copas",
    texto: "Liga Profesional, Brasileirão, Premier League, La Liga, Serie A, Bundesliga y Ligue 1, con Libertadores, Champions y las copas nacionales de cada equipo.",
  },
  {
    numero: "03",
    titulo: "Recordatorios",
    texto: "Notificaciones 1 hora y 15 minutos antes de cada partido.",
  },
];
---

<Layout
  title="FISTURE: fixture de fútbol en Google Calendar y Outlook"
  descripcion="El fixture de fútbol en tu Google Calendar u Outlook: Liga Profesional, Premier League, Libertadores y más, con horarios que se actualizan solos."
  jsonLd={[jsonLdSitio(Astro.locals.runtime.env.PUBLIC_APP_URL)]}
>
  <div style="display:flex;flex-direction:column;gap:48px">
    {cuentaEliminada && (
      <p role="status" style="margin:0;padding:14px 16px;border:2px solid var(--tinta);font:600 15px/22px var(--font-texto)">
        Tu cuenta se eliminó y tus datos se borraron. Los eventos que ya estaban en tu calendario siguen ahí.
      </p>
    )}
    <div style="display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:32px">
      <div style="display:flex;flex-direction:column;align-items:flex-start;gap:20px;max-width:720px">
        <Volanta tono="rojo">Fixture sync</Volanta>
        <Titular nivel="tapa">TODOS TUS PARTIDOS EN TU CALENDARIO</Titular>
        <Bajada>Elegís tus equipos una vez y Fisture carga cada partido en Google Calendar o Outlook, con dos avisos: uno 1 hora antes y otro 15 minutos antes.</Bajada>
        <div class="mv-bloque" style="display:flex;flex-wrap:wrap;gap:16px;align-items:center;margin-top:8px">
          <Boton variante="primario" href="/login">Empezá gratis <span aria-hidden="true">→</span></Boton>
          <Boton href="/hoy">Ver partidos de hoy</Boton>
          <span style="font:600 14px/18px var(--font-rotulo);letter-spacing:.04em;text-transform:uppercase;color:var(--tinta-suave)">
            Sin tarjeta · Sync diario a las 6 hs
          </span>
        </div>
      </div>
      <div class="tb-solo-escritorio"><Sello arriba="Siempre" centro="GRATIS" abajo="2 calendarios" /></div>
    </div>

    <div style="display:flex;flex-direction:column;align-items:flex-start;gap:28px">
      <h2 style="margin:0;font:inherit;display:flex"><Volanta tono="tinta">Así funciona</Volanta></h2>
      <div style="width:100%;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:24px">
        {pasos.map((p) => (
          <div style="border-top:4px solid var(--rojo);padding-top:16px;display:flex;flex-direction:column;gap:8px">
            <div style="font:400 40px/1 var(--font-titular);color:var(--rojo)">{p.numero}</div>
            <h3 style="margin:0;font:400 26px/1.05 var(--font-titular);text-transform:uppercase">{p.titulo}</h3>
            <p style="margin:0;font:400 15px/22px var(--font-texto);color:var(--tinta-suave)">{p.texto}</p>
          </div>
        ))}
      </div>
    </div>

    <section aria-labelledby="que-es" style="max-width:720px;display:flex;flex-direction:column;align-items:flex-start;gap:12px">
      <h2 id="que-es" style="margin:0;font:400 32px/1.05 var(--font-titular);text-transform:uppercase">Qué es Fisture</h2>
      <p style="margin:0;font:400 16px/24px var(--font-texto);color:var(--tinta-suave)">
        Fisture es una app gratuita que pasa el fixture de fútbol a tu calendario. Seguís a tu equipo o a una liga entera y
        cada partido aparece en Google Calendar u Outlook con el día, la hora argentina y el estadio. Si un partido se
        reprograma o se suspende, el evento se corrige solo.
      </p>
      <p style="margin:0;font:400 16px/24px var(--font-texto);color:var(--tinta-suave)">
        Para mirar el fixture no hace falta cuenta: revisá los <a href="/hoy" style="color:var(--tinta);text-decoration:underline;text-underline-offset:3px">partidos de hoy</a>,
        los <a href="/partidos" style="color:var(--tinta);text-decoration:underline;text-underline-offset:3px">próximos partidos</a>, el fixture de cada
        <a href="/ligas" style="color:var(--tinta);text-decoration:underline;text-underline-offset:3px">liga</a> o <a href="/equipos/buscar" style="color:var(--tinta);text-decoration:underline;text-underline-offset:3px">buscá tu equipo</a>.
      </p>
    </section>

    <div style="max-width:720px;display:flex;flex-direction:column;align-items:flex-start;gap:12px;border-left:4px solid var(--tinta);padding-left:16px">
      <span style="font:700 14px/18px var(--font-rotulo);letter-spacing:.06em;text-transform:uppercase">¿Por qué pide acceso a mi calendario?</span>
      <p style="margin:0;font:400 16px/24px var(--font-texto);color:var(--tinta-suave)">
        Para crear los eventos de tus partidos y corregirlos si cambia el horario. Fisture solo toca los eventos que
        crea: no lee tus mails ni tus contactos, y podés quitar el acceso cuando quieras.
      </p>
      <a href="/ayuda" class="tb-enlace-tactil" style="font:700 14px/18px var(--font-rotulo);letter-spacing:.04em;text-transform:uppercase;color:var(--rojo)">Preguntas frecuentes <span aria-hidden="true">→</span></a>
    </div>
  </div>
</Layout>
