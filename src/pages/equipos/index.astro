---
import Layout from "../../layouts/Layout.astro";
import { createDb } from "../../lib/db";
import { userTeams, teams, leagues } from "../../../drizzle/schema";
import { eq, desc } from "drizzle-orm";

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect("/login");
}

const db = createDb(Astro.locals.runtime.env.DB);

const myTeams = await db
  .select({
    userTeam: userTeams,
    team: teams,
    league: leagues,
  })
  .from(userTeams)
  .innerJoin(teams, eq(userTeams.teamId, teams.id))
  .innerJoin(leagues, eq(teams.leagueId, leagues.id))
  .where(eq(userTeams.userId, user.id))
  .orderBy(desc(userTeams.createdAt));

// Obtener todas las ligas disponibles
const allLeagues = await db.select().from(leagues);
---

<Layout title="Mis Equipos - FISTURE">
  <div class="max-w-4xl mx-auto px-4 py-8">
    <div class="flex justify-between items-center mb-8">
      <h1 class="text-3xl font-bold">Mis Equipos</h1>
      <a href="/equipos/buscar" class="btn btn-primary">+ Agregar equipo</a>
    </div>

    {myTeams.length === 0 ? (
      <div class="text-center py-12 bg-white rounded-lg shadow">
        <div class="text-5xl mb-4">⚽</div>
        <p class="text-gray-600 mb-4">No seguís ningún equipo todavía</p>
        <a href="/equipos/buscar" class="btn btn-primary">Buscar equipos</a>
      </div>
    ) : (
      <div class="grid gap-4 md:grid-cols-2">
        {myTeams.map(({ team, league, userTeam }) => (
          <a href={`/equipos/${team.id}`} class="card flex items-center gap-4 hover:shadow-lg transition-shadow">
            <img
              src={team.logo || "/placeholder-team.svg"}
              alt={team.name}
              class="w-16 h-16 object-contain"
            />
            <div class="flex-1">
              <p class="font-bold">{team.name}</p>
              <p class="text-sm text-gray-500">{league.name}</p>
            </div>
            {userTeam.autoSync && (
              <span class="badge badge-success">Auto-sync</span>
            )}
            <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        ))}
      </div>
    )}

    <div class="mt-12">
      <h2 class="text-xl font-bold mb-4">Explorar por Liga</h2>
      <div class="grid gap-4 md:grid-cols-3">
        {allLeagues.map((league) => (
          <a href={`/ligas/${league.id}`} class="card text-center hover:shadow-lg transition-shadow">
            <p class="font-medium">{league.name}</p>
            <p class="text-sm text-gray-500">{league.country}</p>
          </a>
        ))}
      </div>
    </div>
  </div>
</Layout>
