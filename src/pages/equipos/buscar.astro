---
import Layout from "../../layouts/Layout.astro";

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect("/login");
}
---

<Layout title="Buscar Equipos - FISTURE">
  <div class="max-w-2xl mx-auto px-4 py-8">
    <div class="flex items-center gap-4 mb-8">
      <a href="/equipos" class="text-gray-500 hover:text-gray-700">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
      </a>
      <h1 class="text-3xl font-bold">Buscar Equipos</h1>
    </div>

    <input
      type="text"
      id="search-input"
      placeholder="Buscar equipo por nombre..."
      class="input text-lg mb-4"
      autofocus
    />

    <div id="results" class="space-y-2"></div>

    <div class="mt-8 p-4 bg-gray-100 rounded-lg">
      <h3 class="font-medium mb-2">Ligas disponibles:</h3>
      <div class="flex flex-wrap gap-2">
        <span class="badge badge-info">Liga Argentina</span>
        <span class="badge badge-info">Premier League</span>
        <span class="badge badge-info">La Liga</span>
        <span class="badge badge-info">Serie A</span>
        <span class="badge badge-info">Bundesliga</span>
        <span class="badge badge-info">Ligue 1</span>
      </div>
    </div>
  </div>

  <script>
    const input = document.getElementById('search-input') as HTMLInputElement;
    const results = document.getElementById('results')!;
    let timeout: ReturnType<typeof setTimeout>;

    input.addEventListener('input', () => {
      clearTimeout(timeout);
      const query = input.value.trim();

      if (query.length < 2) {
        results.innerHTML = '<p class="text-gray-400 text-center text-sm">Escribí al menos 2 caracteres</p>';
        return;
      }

      timeout = setTimeout(async () => {
        results.innerHTML = '<p class="text-gray-500 text-center">Buscando...</p>';

        const res = await fetch(`/api/equipos/buscar?q=${encodeURIComponent(query)}`);
        const teams = await res.json();

        if (teams.length === 0) {
          results.innerHTML = `<p class="text-gray-500 text-center">No se encontraron equipos para "${query}"</p>`;
          return;
        }

        results.innerHTML = teams.map((team: any) => `
          <div class="flex items-center gap-4 p-3 bg-white rounded-lg border">
            <img src="${team.logo || '/placeholder-team.svg'}" alt="${team.name}" class="w-12 h-12 object-contain" />
            <div class="flex-1">
              <p class="font-medium">${team.name}</p>
              <p class="text-sm text-gray-500">${team.league.name}</p>
            </div>
            ${team.isFollowing
              ? '<span class="text-green-600 text-sm">Siguiendo ✓</span>'
              : `<button onclick="addTeam('${team.id}')" class="btn btn-primary btn-sm">Agregar</button>`
            }
          </div>
        `).join('');
      }, 300);
    });

    (window as any).addTeam = async (teamId: string) => {
      const res = await fetch('/api/equipos', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ teamId }),
      });

      if (res.ok) {
        input.dispatchEvent(new Event('input'));
      }
    };
  </script>
</Layout>
