---
import Layout from "../../layouts/Layout.astro";
import Volanta from "../../components/tribuna/Volanta.astro";
import Titular from "../../components/tribuna/Titular.astro";
import BarraSeccion from "../../components/tribuna/BarraSeccion.astro";
import FiltroEquipos from "../../components/islands/FiltroEquipos";
import { createDb } from "../../lib/db";
import { asc, eq } from "drizzle-orm";
import { leagues, leagueTeams, teams, userTeams } from "../../../drizzle/schema";

// Página pública: sin sesión se puede buscar; seguir un equipo pide iniciar sesión
const user = Astro.locals.user;

const db = createDb(Astro.locals.runtime.env.DB);

const todasLasLigas = await db.select().from(leagues).where(eq(leagues.isActive, true)).orderBy(asc(leagues.name));
const ligaPorId = new Map(todasLasLigas.map((l) => [l.id, l.name]));

const todosLosEquipos = await db
  .select({ id: teams.id, name: teams.name, shortName: teams.shortName, logo: teams.logo, leagueId: teams.leagueId })
  .from(teams)
  .orderBy(asc(teams.name));

// Competencias que juega cada equipo (solo las activas)
const ligasActivas = new Set(todasLasLigas.map((l) => l.id));
const participacion = new Map<string, string[]>();
for (const p of await db.select().from(leagueTeams)) {
  if (!ligasActivas.has(p.leagueId)) continue;
  const lista = participacion.get(p.teamId) ?? [];
  lista.push(p.leagueId);
  participacion.set(p.teamId, lista);
}

const seguidos = new Set(
  user
    ? (await db.select({ teamId: userTeams.teamId }).from(userTeams).where(eq(userTeams.userId, user.id))).map(
        (r) => r.teamId
      )
    : []
);

const items = todosLosEquipos
  .filter((t) => participacion.has(t.id))
  .map((t) => ({
    id: t.id,
    nombre: t.name,
    logo: t.logo,
    sigla: t.shortName,
    ligaIds: participacion.get(t.id)!,
    liga: ligaPorId.get(t.leagueId) ?? "",
    siguiendo: seguidos.has(t.id),
  }));
---

<Layout title="Buscar equipos - FISTURE" pagina={4}>
  <div style="max-width:760px;display:flex;flex-direction:column;gap:24px">
    <a href="/ligas" class="tb-volver">← Ligas</a>
    <div style="display:flex;flex-direction:column;align-items:flex-start;gap:12px">
      <Volanta tono="tinta">Todos los equipos</Volanta>
      <Titular nivel="1">BUSCAR EQUIPOS</Titular>
    </div>

    <BarraSeccion tono="tinta" extra={`${items.length} equipos`}>Equipos disponibles</BarraSeccion>

    {items.length === 0 ? (
      <p style="margin:0;font:400 17px/27px var(--font-texto);color:var(--tinta-suave)">
        Todavía no hay equipos cargados. Se cargan al sincronizar las ligas.
      </p>
    ) : (
      <FiltroEquipos
        client:load
        anonimo={!user}
        equipos={items}
        ligas={todasLasLigas.map((l) => ({ id: l.id, nombre: l.name }))}
        modo="seguir"
        placeholder="River, Liverpool, Inter…"
      />
    )}
  </div>
</Layout>
