---
import Layout from "../../layouts/Layout.astro";
import Volanta from "../../components/tribuna/Volanta.astro";
import Titular from "../../components/tribuna/Titular.astro";
import Boton from "../../components/tribuna/Boton.astro";
import BarraSeccion from "../../components/tribuna/BarraSeccion.astro";
import Escudo from "../../components/tribuna/Escudo.astro";
import SeguimientoEquipo from "../../components/islands/SeguimientoEquipo";
import SincronizarPartido from "../../components/islands/SincronizarPartido";
import { createDb } from "../../lib/db";
import { getTeamUpcomingMatches, getSyncStates } from "../../lib/db/queries";
import { and, eq } from "drizzle-orm";
import { leagues, teams, userTeams } from "../../../drizzle/schema";
import { fechaCorta, hora } from "../../lib/format";
import { loginHref } from "../../lib/auth/guards";

// Página pública: seguir al equipo y el estado de sync solo aplican con sesión
const user = Astro.locals.user;

const { id } = Astro.params;
if (!id) {
  return Astro.redirect("/ligas");
}

const db = createDb(Astro.locals.runtime.env.DB);

const team = await db.query.teams.findFirst({ where: eq(teams.id, id) });
if (!team) {
  return Astro.redirect("/ligas");
}

const liga = await db.query.leagues.findFirst({ where: eq(leagues.id, team.leagueId) });

const seguimiento = user
  ? await db.query.userTeams.findFirst({
      where: and(eq(userTeams.userId, user.id), eq(userTeams.teamId, id)),
    })
  : undefined;

const todos = await getTeamUpcomingMatches(db, id, 50);

const lado = Astro.url.searchParams.get("lado") === "local" ? "local"
  : Astro.url.searchParams.get("lado") === "visitante" ? "visitante"
  : "todos";

const partidos = todos.filter((m) => {
  if (lado === "local") return m.homeTeam.id === id;
  if (lado === "visitante") return m.awayTeam.id === id;
  return true;
});

const estados = user
  ? await getSyncStates(db, user.id, partidos.map((m) => m.match.id))
  : new Map<string, { status: string; errorMessage: string | null }>();

const filtros = [
  { valor: "todos", label: "Todos" },
  { valor: "local", label: "Local" },
  { valor: "visitante", label: "Visitante" },
];
---

<Layout title={`${team.name} - FISTURE`} pagina={3}>
  <div style="display:flex;flex-direction:column;gap:32px">
    <div class="eq-mig" style="display:flex;flex-wrap:wrap;align-items:center;gap:8px;font:700 14px/18px var(--font-rotulo);color:var(--tinta-suave)">
      <a href="/ligas" style="color:var(--tinta);text-decoration:none;letter-spacing:.06em;text-transform:uppercase">Ligas</a>
      <span>/</span>
      {liga && (
        <>
          <a href={`/ligas/${liga.id}`} style="color:var(--tinta);text-decoration:none;letter-spacing:.06em;text-transform:uppercase">{liga.name}</a>
          <span>/</span>
        </>
      )}
      <span style="letter-spacing:.06em;text-transform:uppercase">{team.name}</span>
    </div>

    <div class="eq-cab" style="display:flex;flex-wrap:wrap;gap:32px;align-items:flex-end">
      <div class="eq-escudo" style="box-shadow:4px 4px 0 var(--rojo)">
        <Escudo src={team.logo} nombre={team.name} sigla={team.shortName} size={160} pad={20} />
      </div>
      <div class="eq-titulo" style="flex:1;min-width:280px;display:flex;flex-direction:column;align-items:flex-start;gap:12px">
        <Volanta tono="rojo">{liga?.name ?? "Liga"}</Volanta>
        <Titular nivel="1">{team.name}</Titular>
        <div class="eq-acciones" style="display:flex;flex-wrap:wrap;gap:16px;align-items:center">
          <SeguimientoEquipo
            client:load
            anonimo={!user}
            teamId={team.id}
            nombre={team.name}
            siguiendo={!!seguimiento}
            autoSync={!!seguimiento?.autoSync}
          />
          {partidos.length > 0 && (
            <Boton href={user ? `/api/calendario/download?teamId=${team.id}` : loginHref(Astro.url.pathname + Astro.url.search)}>Descargar .ics</Boton>
          )}
        </div>
      </div>
    </div>

    <div style="display:flex;flex-direction:column">
      <BarraSeccion tono="rojo" extra={`${partidos.length} ${partidos.length === 1 ? "partido" : "partidos"}`}>
        Próximos partidos
      </BarraSeccion>

      <div style="display:flex;flex-wrap:wrap;gap:8px;padding:16px 0 8px">
        {filtros.map((f) => (
          <a href={`?lado=${f.valor}`} aria-current={lado === f.valor ? "true" : undefined} class={lado === f.valor ? "tb-chip tb-chip--activo" : "tb-chip"}>{f.label}</a>
        ))}
      </div>

      {partidos.length === 0 ? (
        <p style="margin:0;padding:24px 12px;font:400 17px/27px var(--font-texto);color:var(--tinta-suave)">
          No hay partidos programados. Se cargan automáticamente desde la API.
        </p>
      ) : (
        partidos.map((m) => {
          const esLocal = m.homeTeam.id === id;
          const rival = esLocal ? m.awayTeam : m.homeTeam;
          const estado = estados.get(m.match.id);
          return (
            <div class="eq-fila" style="display:flex;flex-wrap:wrap;align-items:center;gap:12px 20px;padding:14px 12px;border-bottom:1px solid var(--linea)">
              <a
                href={`/partidos/${m.match.id}`}
                class="eq-enlace"
                style="flex:1;min-width:220px;display:flex;align-items:center;gap:20px;color:var(--tinta);text-decoration:none"
              >
                <div class="eq-hora" style="flex:none;width:96px;display:flex;flex-direction:column">
                  <span style="font:700 13px/16px var(--font-rotulo);letter-spacing:.06em;text-transform:uppercase;color:var(--rojo)">{m.match.round ?? ""}</span>
                  <span style="font:400 26px/1 var(--font-titular)">{hora(m.match.dateTime)}</span>
                  <span style="font:600 13px/16px var(--font-rotulo);letter-spacing:.04em;text-transform:uppercase;color:var(--tinta-suave)">{fechaCorta(m.match.dateTime)}</span>
                </div>
                <div style="display:flex;align-items:center;gap:12px;min-width:0">
                  <Escudo src={rival.logo} nombre={rival.name} sigla={rival.shortName} size={44} />
                  <div style="min-width:0;display:flex;flex-direction:column;gap:2px">
                    <span style="font:700 17px/20px var(--font-rotulo);text-transform:uppercase">vs {rival.name}</span>
                    <span style="font:500 13px/17px var(--font-rotulo);color:var(--tinta-suave)">
                      {esLocal ? "Local" : "Visitante"} · {m.match.venue ?? "Sede a confirmar"}
                    </span>
                  </div>
                </div>
              </a>
              <SincronizarPartido
                client:visible
                anonimo={!user}
                matchId={m.match.id}
                status={estado?.status ?? null}
                errorMessage={estado?.errorMessage ?? null}
              />
            </div>
          );
        })
      )}
    </div>
  </div>
</Layout>
