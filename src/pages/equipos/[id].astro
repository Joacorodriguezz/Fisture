---
import Layout from "../../layouts/Layout.astro";
import Volanta from "../../components/tribuna/Volanta.astro";
import Titular from "../../components/tribuna/Titular.astro";
import Boton from "../../components/tribuna/Boton.astro";
import BarraSeccion from "../../components/tribuna/BarraSeccion.astro";
import Escudo from "../../components/tribuna/Escudo.astro";
import SeguimientoEquipo from "../../components/islands/SeguimientoEquipo";
import SincronizarPartido from "../../components/islands/SincronizarPartido";
import { createDb } from "../../lib/db";
import { getTeamRecentMatches, getTeamUpcomingMatches, getSyncStates } from "../../lib/db/queries";
import { and, eq } from "drizzle-orm";
import { leagues, leagueTeams, teams, userTeams } from "../../../drizzle/schema";
import { fechaCorta, hora } from "../../lib/format";
import { loginHref } from "../../lib/auth/guards";
import { jsonLdEquipo, jsonLdMigas, rutaPublica } from "../../lib/seo";
import {
  descripcionEquipo,
  encabezadoEquipo,
  jsonLdPartidosDeEquipo,
  respuestaProximoPartido,
  resultadoDelEquipo,
  tituloEquipo,
} from "../../lib/seo-equipo";

// Página pública: seguir al equipo y el estado de sync solo aplican con sesión
const user = Astro.locals.user;

const { id } = Astro.params;
if (!id) {
  return Astro.rewrite("/404");
}

const db = createDb(Astro.locals.runtime.env.DB);

const team = await db.query.teams.findFirst({ where: eq(teams.id, id) });
if (!team) {
  return Astro.rewrite("/404");
}

const liga = await db.query.leagues.findFirst({ where: eq(leagues.id, team.leagueId) });

// Todo lo que juega en la temporada: su liga, las copas internacionales y las nacionales (docs/22)
const competencias = (
  await db
    .select({ id: leagues.id, name: leagues.name, isFeatured: leagues.isFeatured })
    .from(leagueTeams)
    .innerJoin(leagues, eq(leagueTeams.leagueId, leagues.id))
    .where(and(eq(leagueTeams.teamId, id), eq(leagues.isActive, true)))
).sort((a, b) => {
  if (a.id === team.leagueId) return -1;
  if (b.id === team.leagueId) return 1;
  if (a.isFeatured !== b.isFeatured) return a.isFeatured ? -1 : 1;
  return a.name.localeCompare(b.name, "es");
});

const seguimiento = user
  ? await db.query.userTeams.findFirst({
      where: and(eq(userTeams.userId, user.id), eq(userTeams.teamId, id)),
    })
  : undefined;

const todos = await getTeamUpcomingMatches(db, id, 50);
// Últimos resultados (docs/33 D3): hasta 5 terminados, por los índices de local y visitante
const recientes = await getTeamRecentMatches(db, id);

const lado = Astro.url.searchParams.get("lado") === "local" ? "local"
  : Astro.url.searchParams.get("lado") === "visitante" ? "visitante"
  : "todos";

const partidos = todos.filter((m) => {
  if (lado === "local") return m.homeTeam.id === id;
  if (lado === "visitante") return m.awayTeam.id === id;
  return true;
});

const estados = user
  ? await getSyncStates(db, user.id, partidos.map((m) => m.match.id))
  : new Map<string, { status: string; errorMessage: string | null }>();

const appUrl = Astro.locals.runtime.env.PUBLIC_APP_URL;
const proximo = todos.find(({ match }) => match.status === "scheduled");
const descripcion = descripcionEquipo(team, liga, proximo);
// Respuesta directa a "cuándo juega X" (docs/33 D2)
const respuesta = respuestaProximoPartido(team, proximo, recientes[0]);
// Sin ningún partido por jugar ni terminado la página no tiene contenido propio: noindex y fuera del
// sitemap (docs/33 D8, misma condición que getPaginasPublicas). Vuelve a indexarse cuando tenga partidos.
const sinPartidos = todos.length === 0 && recientes.length === 0;
const jsonLd = [
  jsonLdEquipo(appUrl, team, liga),
  // Sobre la lista completa del equipo, no la filtrada por ?lado= (docs/33 D6)
  ...jsonLdPartidosDeEquipo(appUrl, todos),
  jsonLdMigas(appUrl, [
    { nombre: "Ligas", ruta: "/ligas" },
    ...(liga ? [{ nombre: liga.name, ruta: rutaPublica("ligas", liga.id) }] : []),
    { nombre: team.name, ruta: rutaPublica("equipos", team.id) },
  ]),
];

const filtros = [
  { valor: "todos", label: "Todos" },
  { valor: "local", label: "Local" },
  { valor: "visitante", label: "Visitante" },
];
---

<Layout title={tituloEquipo(team.name)} pagina={3} descripcion={descripcion} jsonLd={jsonLd} noindex={sinPartidos}>
  <div style="display:flex;flex-direction:column;gap:32px">
    <nav aria-label="Migas de pan" class="tb-migas">
      <ol class="eq-mig" style="list-style:none;padding:0;margin:0;display:flex;flex-wrap:wrap;align-items:center;gap:8px;font:700 14px/18px var(--font-rotulo);color:var(--tinta-suave)">
        <li style="display:flex;align-items:center;gap:8px">
          <a href="/ligas" style="color:var(--tinta);text-decoration:none;letter-spacing:.06em;text-transform:uppercase">Ligas</a>
          <span aria-hidden="true">/</span>
        </li>
        {liga && (
          <li style="display:flex;align-items:center;gap:8px">
            <a href={`/ligas/${liga.id}`} style="color:var(--tinta);text-decoration:none;letter-spacing:.06em;text-transform:uppercase">{liga.name}</a>
            <span aria-hidden="true">/</span>
          </li>
        )}
        <li aria-current="page" style="letter-spacing:.06em;text-transform:uppercase">{team.name}</li>
      </ol>
    </nav>

    <div class="eq-cab" style="display:flex;flex-wrap:wrap;gap:32px;align-items:flex-end">
      <div class="eq-escudo" style="box-shadow:4px 4px 0 var(--rojo)">
        <Escudo src={team.logo} nombre={team.name} sigla={team.shortName} size={160} pad={20} prioridad />
      </div>
      <div class="eq-titulo" style="flex:1;min-width:280px;display:flex;flex-direction:column;align-items:flex-start;gap:12px">
        <Volanta tono="rojo">{liga ? <a href={rutaPublica("ligas", liga.id)} class="fp-enlace">{liga.name}</a> : "Liga"}</Volanta>
        <Titular nivel="1">{encabezadoEquipo(team.name)}</Titular>
        {competencias.length > 1 && (
          <p class="eq-competencias" style="margin:0;font:600 14px/20px var(--font-rotulo);letter-spacing:.04em;text-transform:uppercase;color:var(--tinta-suave)">
            Juega {competencias.map((c) => c.name).join(" · ")}
          </p>
        )}
        <div class="eq-acciones" style="display:flex;flex-wrap:wrap;gap:16px;align-items:center">
          <SeguimientoEquipo
            client:load
            anonimo={!user}
            teamId={team.id}
            nombre={team.name}
            siguiendo={!!seguimiento}
            autoSync={!!seguimiento?.autoSync}
          />
          {partidos.length > 0 && (
            <Boton href={user ? `/api/calendario/download?teamId=${team.id}` : loginHref(Astro.url.pathname + Astro.url.search)}>Descargar .ics</Boton>
          )}
        </div>
      </div>
    </div>

    <section aria-labelledby="proximo-partido" style="border-top:3px solid var(--rojo);padding-top:20px">
      <h2 id="proximo-partido" style="margin:0;font:400 32px/1.1 var(--font-titular)">Próximo partido</h2>
      <p class="eq-respuesta" style="margin:12px 0 0;max-width:68ch;font:400 19px/1.55 var(--font-texto)">{respuesta}</p>
      {proximo && (
        <p style="margin:12px 0;font:400 18px/1.6 var(--font-texto)">
          <a href={rutaPublica("partidos", proximo.match.id)} style="color:var(--tinta);text-decoration:underline;text-underline-offset:4px">
            {proximo.homeTeam.name} vs {proximo.awayTeam.name}
          </a><br />
          <time datetime={proximo.match.dateTime.toISOString()}>{fechaCorta(proximo.match.dateTime)} · {hora(proximo.match.dateTime)} hs</time>
          {" · "}{proximo.league.name}{" · "}{proximo.match.venue ?? "Sede a confirmar"}
        </p>
      )}
      <p style="margin:12px 0 0;font:400 15px/1.6 var(--font-texto);color:var(--tinta-suave)">Todos los horarios están en hora de Argentina (UTC−3).</p>
    </section>

    {/* El diferencial, visible (docs/33 D5). Reemplaza al aviso de login que estaba sobre la lista */}
    <section aria-labelledby="en-tu-calendario" class="eq-calendario">
      <div style="flex:1 1 280px;display:flex;flex-direction:column;gap:8px">
        <h2 id="en-tu-calendario" style="margin:0;font:400 26px/1.1 var(--font-titular)">En tu calendario</h2>
        <p>
          Si seguís a {team.name}, sus partidos aparecen como eventos en tu Google Calendar u Outlook.
          Si cambia el día o la hora, el evento se actualiza solo. Te avisa una hora antes de cada partido y otra vez 15 minutos antes.
          Es gratis.
        </p>
        <p><a href="/calendario" class="fp-enlace">Cómo funciona el fixture en tu calendario</a></p>
      </div>
      {!user && <Boton href={loginHref(Astro.url.pathname + Astro.url.search)} variante="tinta">Iniciá sesión</Boton>}
    </section>

    <div style="display:flex;flex-direction:column">
      <BarraSeccion tono="rojo" extra={`${partidos.length} ${partidos.length === 1 ? "partido" : "partidos"}`}>
        Próximos partidos
      </BarraSeccion>

      <div style="display:flex;flex-wrap:wrap;gap:8px;padding:16px 0 8px">
        {filtros.map((f) => (
          <a href={`?lado=${f.valor}`} aria-current={lado === f.valor ? "true" : undefined} class={lado === f.valor ? "tb-chip tb-chip--activo" : "tb-chip"}>{f.label}</a>
        ))}
      </div>

      {partidos.length === 0 ? (
        <p style="margin:0;padding:24px 12px;font:400 17px/27px var(--font-texto);color:var(--tinta-suave)">
          Todavía no hay partidos programados. Aparecen apenas se confirma el fixture.
        </p>
      ) : (
        partidos.map((m) => {
          const esLocal = m.homeTeam.id === id;
          const rival = esLocal ? m.awayTeam : m.homeTeam;
          const estado = estados.get(m.match.id);
          return (
            <div class="eq-fila" style="display:flex;flex-wrap:wrap;align-items:center;gap:12px 20px;padding:14px 12px;border-bottom:1px solid var(--linea)">
              <a
                href={`/partidos/${m.match.id}`}
                class="eq-enlace"
                style="flex:1;min-width:220px;display:flex;align-items:center;gap:20px;color:var(--tinta);text-decoration:none"
              >
                <div class="eq-hora" style="flex:none;width:96px;display:flex;flex-direction:column">
                  <span style="font:700 13px/16px var(--font-rotulo);letter-spacing:.06em;text-transform:uppercase;color:var(--rojo)">{m.match.round ?? ""}</span>
                  <span class="tb-cifra" style="font:400 26px/1 var(--font-titular)">{hora(m.match.dateTime)}</span>
                  <span style="font:600 13px/16px var(--font-rotulo);letter-spacing:.04em;text-transform:uppercase;color:var(--tinta-suave)">{fechaCorta(m.match.dateTime)}</span>
                </div>
                <div style="display:flex;align-items:center;gap:12px;min-width:0">
                  <Escudo src={rival.logo} nombre={rival.name} sigla={rival.shortName} size={44} />
                  <div style="min-width:0;display:flex;flex-direction:column;gap:2px">
                    <span style="font:700 17px/20px var(--font-rotulo);text-transform:uppercase">vs {rival.name}</span>
                    <span style="font:500 13px/17px var(--font-rotulo);color:var(--tinta-suave)">
                      {m.league.name} · {esLocal ? "Local" : "Visitante"} · {m.match.venue ?? "Sede a confirmar"}
                    </span>
                  </div>
                </div>
                {!user && <span class="eq-flecha" aria-hidden="true">›</span>}
              </a>
              {/* Sin sesión la acción está en el bloque "En tu calendario" y en la ficha del partido */}
              {user && (
                <SincronizarPartido
                  client:visible
                  matchId={m.match.id}
                  status={estado?.status ?? null}
                  errorMessage={estado?.errorMessage ?? null}
                />
              )}
            </div>
          );
        })
      )}
    </div>

    {recientes.length > 0 && (
      <section aria-label="Últimos resultados" style="display:flex;flex-direction:column">
        <BarraSeccion tono="tinta" extra={`${recientes.length} ${recientes.length === 1 ? "partido" : "partidos"}`}>
          Últimos resultados
        </BarraSeccion>
        <ol style="list-style:none;margin:0;padding:0">
          {recientes.map((m) => {
            const esLocal = m.homeTeam.id === id;
            const rival = esLocal ? m.awayTeam : m.homeTeam;
            // Solo con los dos goles cargados: un marcador nunca se inventa (docs/33 D3). Va desde el
            // lado del equipo (goles propios primero), como el "ganó 2 a 0" de la respuesta directa
            const r = resultadoDelEquipo(m.match, esLocal);
            return (
              <li style="border-bottom:1px solid var(--linea)">
                <a
                  href={rutaPublica("partidos", m.match.id)}
                  class="eq-enlace"
                  style="display:flex;align-items:center;gap:12px 20px;padding:14px 12px;color:var(--tinta);text-decoration:none"
                >
                  <div class="eq-hora" style="flex:none;width:96px;display:flex;flex-direction:column">
                    <span style="font:700 13px/16px var(--font-rotulo);letter-spacing:.06em;text-transform:uppercase;color:var(--rojo)">{m.match.round ?? ""}</span>
                    <time datetime={m.match.dateTime.toISOString()} style="font:600 13px/16px var(--font-rotulo);letter-spacing:.04em;text-transform:uppercase;color:var(--tinta-suave)">{fechaCorta(m.match.dateTime)}</time>
                  </div>
                  <div style="flex:1;min-width:0;display:flex;align-items:center;gap:12px">
                    <Escudo src={rival.logo} nombre={rival.name} sigla={rival.shortName} size={44} />
                    <div style="min-width:0;display:flex;flex-direction:column;gap:2px">
                      <span style="font:700 17px/20px var(--font-rotulo);text-transform:uppercase">vs {rival.name}</span>
                      <span style="font:500 13px/17px var(--font-rotulo);color:var(--tinta-suave)">
                        {m.league.name} · {esLocal ? "Local" : "Visitante"}
                      </span>
                    </div>
                  </div>
                  {r ? (
                    <span class="eq-marcador" style="flex:none;display:flex;flex-direction:column;align-items:flex-end">
                      <span style="font:700 12px/16px var(--font-rotulo);letter-spacing:.06em;text-transform:uppercase;color:var(--tinta-suave)">{r.resultado}</span>
                      <span class="tb-cifra" style="font:400 26px/1 var(--font-titular)">{r.propios}-{r.ajenos}</span>
                    </span>
                  ) : (
                    <span style="flex:none;font:600 13px/16px var(--font-rotulo);letter-spacing:.04em;text-transform:uppercase;color:var(--tinta-suave)">Terminado</span>
                  )}
                </a>
              </li>
            );
          })}
        </ol>
      </section>
    )}
  </div>
</Layout>
