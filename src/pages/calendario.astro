---
import Layout from "../layouts/Layout.astro";
import Volanta from "../components/tribuna/Volanta.astro";
import Titular from "../components/tribuna/Titular.astro";
import Bajada from "../components/tribuna/Bajada.astro";
import Boton from "../components/tribuna/Boton.astro";
import BarraSeccion from "../components/tribuna/BarraSeccion.astro";
import Recuadro from "../components/tribuna/Recuadro.astro";
import SincronizarTodo from "../components/islands/SincronizarTodo";
import SincronizarPartido from "../components/islands/SincronizarPartido";
import { createDb } from "../lib/db";
import { getUpcomingMatches, getSyncStates } from "../lib/db/queries";
import { markOutdatedEvents } from "../lib/calendar/sync-service";
import { calendarSyncs } from "../../drizzle/schema";
import { eq } from "drizzle-orm";
import { toSyncStatus } from "../lib/sync-ui";
import { loginHref } from "../lib/auth/guards";
import { fechaCorta, fechaHora, hora, providerLabel } from "../lib/format";

// Página pública: sin sesión explica la conexión; el estado del calendario es personal.
const user = Astro.locals.user;

const db = createDb(Astro.locals.runtime.env.DB);

// Eventos cuyo partido cambió de horario quedan marcados antes de mostrar el estado
if (user) await markOutdatedEvents(db, user.id);

const proximos = user ? await getUpcomingMatches(db, user.id, 200) : [];
const estados = user
  ? await getSyncStates(db, user.id, proximos.map((m) => m.match.id))
  : new Map<string, { status: string; errorMessage: string | null }>();

const filasCalendario = user
  ? await db
      .select({ lastSyncedAt: calendarSyncs.lastSyncedAt })
      .from(calendarSyncs)
      .where(eq(calendarSyncs.userId, user.id))
  : [];
const ultima = filasCalendario
  .map((r) => r.lastSyncedAt)
  .filter((d): d is Date => d instanceof Date)
  .sort((a, b) => b.getTime() - a.getTime())[0];

let enCalendario = 0;
let pendientes = 0;
let aActualizar = 0;
let conError = 0;
const revisar: typeof proximos = [];
const accionables: string[] = [];

for (const m of proximos) {
  const registro = estados.get(m.match.id);
  const estado = toSyncStatus(registro?.status);

  if (estado === "synced") enCalendario++;
  if (estado === "none") {
    pendientes++;
    accionables.push(m.match.id);
  }
  if (estado === "needs_update" || estado === "failed") {
    if (estado === "needs_update") aActualizar++;
    else conError++;
    revisar.push(m);
    accionables.push(m.match.id);
  }
}

// La island parte la lista en lotes de MAX_PARTIDOS_POR_REQUEST y los manda en secuencia (docs/16 §12 R2)
const lote = accionables;

const stats = [
  { n: enCalendario, label: "En calendario", detalle: "Eventos creados y al día", color: "var(--celeste)" },
  { n: pendientes, label: "Pendientes", detalle: "Todavía no están en tu calendario", color: "var(--tinta)" },
  { n: aActualizar, label: "A actualizar", detalle: "Cambió fecha, hora o estadio", color: "var(--rojo)" },
  { n: conError, label: "Con error", detalle: "No se pudo escribir el evento", color: "var(--rojo)" },
];

const ultimaTxt = ultima ? fechaHora(ultima) : "todavía no";
const proveedor = user ? providerLabel(user.provider) : "Tu calendario";
const estadoRevision = (id: string) => toSyncStatus(estados.get(id)?.status);
---

<Layout
  title="Fixture de fútbol en Google Calendar y Outlook - FISTURE"
  pagina={7}
  descripcion="Conectá Google Calendar u Outlook y tus partidos aparecen como eventos con avisos 1 hora y 15 minutos antes. Si cambia el horario, el evento se corrige solo."
>
  {!user ? (
    <div style="display:flex;flex-direction:column;align-items:flex-start;gap:20px;max-width:720px">
      <Volanta tono="tinta">Tu calendario</Volanta>
      <Titular nivel="1">Tu fixture en Google Calendar y Outlook</Titular>
      <Bajada>
        Iniciá sesión con Google o Microsoft para ver qué partidos ya están en tu calendario, cuáles faltan y sincronizarlos.
        Mientras tanto podés recorrer los partidos y las ligas sin cuenta.
      </Bajada>
      <div class="mv-bloque" style="display:flex;flex-wrap:wrap;gap:12px">
        <Boton variante="primario" href={loginHref("/calendario")}>Iniciar sesión</Boton>
        <Boton href="/hoy">Ver partidos de hoy</Boton>
      </div>
      <section class="cal-guia" aria-labelledby="conectar-calendario">
        <h2 id="conectar-calendario">Cómo agregar los partidos a tu calendario</h2>
        <ol>
          <li><strong>Conectá tu cuenta.</strong> Iniciá sesión con Google para usar Google Calendar o con Microsoft para usar Outlook. Autorizá el acceso al calendario para que Fisture pueda crear y actualizar los eventos.</li>
          <li><strong>Elegí tus equipos.</strong> Buscalos en <a href="/equipos/buscar">el buscador de equipos</a> o recorré <a href="/ligas">las ligas</a>. Entrá a la ficha de cada equipo y elegí Seguir.</li>
          <li><strong>Activá el auto-sync.</strong> Seguir un equipo organiza tu fixture; activar además el auto-sync permite agregar sus próximos partidos automáticamente. También podés agregar un partido individual desde su ficha.</li>
          <li><strong>Revisá tu calendario.</strong> Al volver a esta página con sesión, vas a ver qué encuentros ya están sincronizados, cuáles faltan y cuáles necesitan una actualización. Usá Sincronizar ahora para procesar los pendientes.</li>
        </ol>
      </section>
      <section class="cal-guia" aria-labelledby="cambios-horario">
        <h2 id="cambios-horario">Horarios, cambios y recordatorios</h2>
        <p>El fixture se actualiza todos los días a las 6 hs de Argentina. Si cambia la fecha, la hora o el estadio de un partido que agregaste, Fisture actualiza el evento cuando procesa la sincronización. No es una actualización en tiempo real.</p>
        <p>En la web mostramos la hora de Argentina (UTC−3). Google Calendar y Outlook muestran el evento según la zona horaria de tu calendario. Podés configurar avisos de 1 hora y 15 minutos antes desde Configuración.</p>
        <p>Si eliminás un evento desde tu calendario, Fisture no lo vuelve a crear automáticamente. Para recuperarlo, abrí el partido y elegí Agregar al calendario.</p>
      </section>
      <section class="cal-guia" aria-labelledby="descargar-ics">
        <h2 id="descargar-ics">Descargar el fixture como archivo .ics</h2>
        <p>Después de iniciar sesión, podés descargar un archivo .ics desde la ficha de un equipo o desde tu calendario e importarlo en una aplicación compatible, como Apple Calendar.</p>
        <p>El archivo es una copia de los horarios al momento de descargarlo: los cambios posteriores no se actualizan solos. Para mantener los eventos sincronizados, conectá Google Calendar u Outlook.</p>
      </section>
      <section class="cal-guia" aria-labelledby="permisos-calendario">
        <h2 id="permisos-calendario">Permisos y control de tu cuenta</h2>
        <p>Fisture necesita permisos de calendario para agregar los partidos y corregir sus horarios. Podés administrar tu conexión desde Configuración y revocar el acceso desde tu cuenta de Google o Microsoft.</p>
        <p>Encontrá el detalle de los permisos y las respuestas a problemas habituales en <a href="/ayuda">Ayuda</a>, y cómo tratamos tus datos en <a href="/privacidad">Privacidad</a>.</p>
      </section>
    </div>
  ) : (
  <div style="display:flex;flex-direction:column;gap:32px">
    <div style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:16px">
      <div style="display:flex;flex-direction:column;align-items:flex-start;gap:12px">
        <Volanta tono="tinta">{proveedor}</Volanta>
        <Titular nivel="1">TODO EN HORARIO</Titular>
      </div>
      <div class="cal-acciones" style="display:flex;flex-wrap:wrap;gap:12px;align-items:flex-end">
        {proximos.length > 0 && <Boton href="/api/calendario/download?all=true">Descargar .ics</Boton>}
        <SincronizarTodo client:visible matchIds={lote} etiqueta={lote.length > 0 ? `Sincronizar ahora (${lote.length})` : "Sincronizar ahora"} etiquetaCargando="Sincronizando…" />
      </div>
    </div>

    <Bajada>Conectado como {user.email} · {proveedor}. Última sincronización: {ultimaTxt}.</Bajada>

    {proximos.length === 0 && (
      <div class="tb-vacio">
        <span>Todavía no tenés partidos para sincronizar. Seguí un equipo y sus partidos aparecen acá.</span>
        <Boton href="/ligas" variante="primario">Elegir equipos</Boton>
      </div>
    )}

    <div class="cal-stats" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,200px),1fr));gap:0;background:var(--celeste-claro);border:2px solid var(--celeste)">
      {stats.map((s, i) => (
        <div style={`padding:20px 16px;border-right:${i < stats.length - 1 ? "1px solid var(--linea)" : "0"};display:flex;flex-direction:column;gap:6px`}>
          <span class="cal-cifra tb-cifra" style={`font:400 64px/.92 var(--font-titular);color:${s.color}`}>{s.n}</span>
          <span style="font:700 14px/18px var(--font-rotulo);letter-spacing:.06em;text-transform:uppercase">{s.label}</span>
          <span style="font:400 14px/19px var(--font-texto);color:var(--tinta-suave)">{s.detalle}</span>
        </div>
      ))}
    </div>

    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:24px;align-items:start">
      <div style="display:flex;flex-direction:column">
        <BarraSeccion tono="rojo" extra={`${revisar.length} ${revisar.length === 1 ? "partido" : "partidos"}`}>
          Para revisar
        </BarraSeccion>

        {revisar.map((m) => {
          const estado = estadoRevision(m.match.id);
          const registro = estados.get(m.match.id);
          return (
            <div class="cal-rev" style="display:flex;flex-wrap:wrap;align-items:center;gap:12px 16px;padding:14px 12px;border-bottom:1px solid var(--linea)">
              <div style="flex:1;min-width:200px;display:flex;flex-direction:column;gap:2px">
                <span style="font:700 13px/16px var(--font-rotulo);letter-spacing:.06em;text-transform:uppercase;color:var(--tinta-suave)">
                  {m.league.name} · {fechaCorta(m.match.dateTime)} <span class="tb-cifra">{hora(m.match.dateTime)}</span>
                </span>
                <a href={`/partidos/${m.match.id}`} style="font:700 17px/20px var(--font-rotulo);text-transform:uppercase;color:var(--tinta);text-decoration:none">
                  {m.homeTeam.name} vs {m.awayTeam.name}
                </a>
              </div>
              <SincronizarPartido
                client:visible
                matchId={m.match.id}
                status={estado}
                errorMessage={registro?.errorMessage ?? null}
              />
            </div>
          );
        })}

        {revisar.length === 0 && (
          <p style="margin:0;padding:20px 12px;font:400 17px/27px var(--font-texto)">
            Nada para revisar. Todos tus partidos están al día.
          </p>
        )}
      </div>

      <Recuadro tono="celeste" titulo="Cómo funciona la sync">
        <div style="display:flex;flex-direction:column;gap:8px">
          <div><b>Todos los días a las 6 hs</b> traemos el fixture actualizado de todas las ligas.</div>
          <div><b>Si cambia un horario</b> actualizamos los eventos que ya agregaste a tu calendario, aunque el equipo tenga auto-sync desactivado.</div>
          <div><b>Si borraste un evento</b> desde tu calendario, respetamos tu decisión y no lo recreamos automáticamente. Para recuperarlo, abrí la ficha del partido y elegí Agregar al calendario.</div>
          <div><b>Otro calendario</b>: descargá el .ics y importalo.</div>
        </div>
      </Recuadro>
    </div>
  </div>
)}
</Layout>

<style>
  .cal-guia { width: 100%; border-top: 2px solid var(--linea); padding-top: 20px; }
  .cal-guia h2 { margin: 0 0 12px; font: 400 30px/1.15 var(--font-titular); }
  .cal-guia p, .cal-guia li { font: 400 17px/1.65 var(--font-texto); }
  .cal-guia p { margin: 12px 0 0; }
  .cal-guia ol { list-style: decimal; padding-left: 24px; margin-bottom: 0; }
  .cal-guia li + li { margin-top: 14px; }
  .cal-guia a { color: var(--tinta); text-decoration: underline; text-underline-offset: 4px; }
</style>
