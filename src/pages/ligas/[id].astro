---
import Layout from "../../layouts/Layout.astro";
import Volanta from "../../components/tribuna/Volanta.astro";
import Titular from "../../components/tribuna/Titular.astro";
import BarraSeccion from "../../components/tribuna/BarraSeccion.astro";
import FiltroEquipos from "../../components/islands/FiltroEquipos";
import { getLeagueBySlugOrId, getLeagueUpcomingMatches } from "../../lib/db/queries";
import { fechaLarga, hora } from "../../lib/format";
import { createDb } from "../../lib/db";
import { asc, eq } from "drizzle-orm";
import { leagueTeams, teams, userTeams } from "../../../drizzle/schema";
import { jsonLdLiga, jsonLdMigas, redireccionASlug, rutaPublica } from "../../lib/seo";

// Página pública: sin sesión nadie "sigue" ningún equipo
const user = Astro.locals.user;

const { id } = Astro.params;
if (!id) {
  return Astro.rewrite("/404");
}

const db = createDb(Astro.locals.runtime.env.DB);

// El parámetro es el slug (/ligas/liga-profesional-argentina) o el id de las URLs viejas (docs/33 D9)
const liga = await getLeagueBySlugOrId(db, id);
if (!liga) {
  return Astro.rewrite("/404");
}
// Por id y con slug: 301 a la URL con nombre, con el mismo query string
const destino = redireccionASlug("ligas", id, liga, Astro.url.search);
if (destino) {
  return Astro.redirect(destino, 301);
}

// Participantes de la competencia (incluye equipos de otras ligas en las copas)
const equiposLiga = await db
  .select({ id: teams.id, name: teams.name, shortName: teams.shortName, logo: teams.logo, slug: teams.slug })
  .from(leagueTeams)
  .innerJoin(teams, eq(leagueTeams.teamId, teams.id))
  .where(eq(leagueTeams.leagueId, liga.id))
  .orderBy(asc(teams.name));

const seguidos = new Set(
  user
    ? (await db.select({ teamId: userTeams.teamId }).from(userTeams).where(eq(userTeams.userId, user.id))).map(
        (r) => r.teamId
      )
    : []
);

const items = equiposLiga.map((t) => ({
  id: t.id,
  ruta: rutaPublica("equipos", t),
  nombre: t.name,
  logo: t.logo,
  sigla: t.shortName,
  ligaIds: [liga.id],
  liga: liga.name,
  siguiendo: seguidos.has(t.id),
}));

const cantidadSeguidos = items.filter((i) => i.siguiendo).length;
const proximos = await getLeagueUpcomingMatches(db, liga.id);

const appUrl = Astro.locals.runtime.env.PUBLIC_APP_URL;
// El país solo si no está en el nombre ("Liga Profesional Argentina (Argentina)") y la cantidad solo si hay equipos
const pais = liga.name.includes(liga.country) ? "" : ` (${liga.country})`;
const equiposTxt = equiposLiga.length > 0 ? `los ${equiposLiga.length} equipos y sus próximos partidos` : "los próximos partidos";
const descripcion = `Fixture de ${liga.name}${pais}: ${equiposTxt} con día y hora. Sincronizalos con Google Calendar u Outlook.`;
const jsonLd = [
  jsonLdLiga(appUrl, liga, equiposLiga),
  jsonLdMigas(appUrl, [
    { nombre: "Ligas", ruta: "/ligas" },
    { nombre: liga.name, ruta: rutaPublica("ligas", liga) },
  ]),
];
---

<Layout title={`Fixture de ${liga.name} - FISTURE`} pagina={3} descripcion={descripcion} jsonLd={jsonLd}>
  <div style="display:flex;flex-direction:column;gap:28px">
    <div style="display:flex;flex-direction:column;gap:16px">
      <a href="/ligas" class="tb-volver"><span aria-hidden="true">←</span> Ligas</a>
      <div style="display:flex;flex-direction:column;align-items:flex-start;gap:12px">
        <Volanta tono="rojo">{liga.country}</Volanta>
        <Titular nivel="1">Fixture de {liga.name}</Titular>
      </div>
    </div>

    <section aria-labelledby="fixture-liga" class="fixture-publico">
      <h2 id="fixture-liga">Próximos partidos</h2>
      <p>Hasta 20 encuentros programados en los próximos 30 días. Hora de Argentina (UTC−3).</p>
      {proximos.length > 0 ? (
        <ul>
          {proximos.map(({ match, homeTeam, awayTeam }) => (
            <li><a href={rutaPublica("partidos", match.id)}>
              <span>{homeTeam.name} vs {awayTeam.name}</span>
              <time datetime={match.dateTime.toISOString()}>{fechaLarga(match.dateTime)} · {hora(match.dateTime)} hs</time>
            </a></li>
          ))}
        </ul>
      ) : <p>No hay partidos programados para mostrar en los próximos 30 días. Podés explorar los equipos de esta competencia abajo.</p>}
      <a href="/calendario">Cómo agregar estos partidos a tu calendario</a>
    </section>

    <div style="display:flex;flex-direction:column;gap:16px">
      <BarraSeccion tono="tinta" extra={`${items.length} equipos${cantidadSeguidos ? ` · seguís ${cantidadSeguidos}` : ""}`}>
        Elegí un equipo
      </BarraSeccion>

      {items.length === 0 ? (
        <div style="background:var(--papel-2);padding:40px 32px;font:400 17px/27px var(--font-texto);text-align:center">
          Todavía no hay equipos cargados para esta liga.
        </div>
      ) : (
        <FiltroEquipos client:visible equipos={items} modo="navegar" placeholder="Filtrá por nombre…" />
      )}
    </div>
  </div>
</Layout>

<style>
  .fixture-publico { border-top: 3px solid var(--rojo); padding-top: 20px; }
  .fixture-publico h2 { margin: 0; font: 400 32px/1.1 var(--font-titular); }
  .fixture-publico p { font: 400 16px/1.6 var(--font-texto); }
  .fixture-publico ul { list-style: none; padding: 0; }
  .fixture-publico li { border-bottom: 1px solid var(--linea); }
  .fixture-publico li a { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 24px; padding: 16px 0; }
  .fixture-publico a { color: var(--tinta); text-decoration: underline; text-underline-offset: 4px; }
  .fixture-publico li a { text-decoration: none; }
  .fixture-publico li span { text-decoration: underline; text-underline-offset: 4px; }
  .fixture-publico li span { font: 700 18px/1.4 var(--font-rotulo); }
  .fixture-publico time { font: 500 15px/1.6 var(--font-rotulo); }
</style>
