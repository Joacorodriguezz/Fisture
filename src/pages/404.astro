---
import Layout from "../layouts/Layout.astro";
import Volanta from "../components/tribuna/Volanta.astro";
import Titular from "../components/tribuna/Titular.astro";
import Bajada from "../components/tribuna/Bajada.astro";
import Boton from "../components/tribuna/Boton.astro";

// Página no encontrada (docs/29): status 404 real para URLs inexistentes, no una redirección.
// Salir de la ventana del sitemap no elimina un partido de la base ni de su ficha.
// La usan las rutas desconocidas y las páginas de liga, equipo o partido con un id que no está en la base.
Astro.response.status = 404;
---

<Layout title="Página no encontrada - FISTURE" descripcion="La página que buscás no existe o el partido ya no está en el fixture." noindex>
  <div style="display:flex;flex-direction:column;align-items:flex-start;gap:20px;max-width:720px">
    <Volanta tono="rojo">Error 404</Volanta>
    <Titular nivel="1">FUERA DE JUEGO</Titular>
    <Bajada>
      No encontramos esta página. Revisá la dirección o buscá el equipo o partido desde alguna de estas secciones.
    </Bajada>
    <div class="mv-bloque" style="display:flex;flex-wrap:wrap;gap:12px">
      <Boton variante="primario" href="/hoy">Partidos de hoy</Boton>
      <Boton href="/partidos">Próximos partidos</Boton>
      <Boton href="/ligas">Ligas</Boton>
      <Boton href="/equipos/buscar">Buscar equipo</Boton>
    </div>
  </div>
</Layout>
