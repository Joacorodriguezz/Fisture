---
import Cabecera from "../components/tribuna/Cabecera.astro";
import Folio from "../components/tribuna/Folio.astro";
import JsonLd from "../components/seo/JsonLd.astro";
import { createDb } from "../lib/db";
import { getPreferences } from "../lib/db/preferences";
import { fechaLarga, fechaMovil, primerNombre } from "../lib/format";
import { loginHref } from "../lib/auth/guards";
import { recortarDescripcion, urlCanonica } from "../lib/seo";
import { SCRIPT_TEMA } from "../lib/security-headers";
import { CONTACTO_EMAIL } from "../lib/legal";
import "../styles/global.css";
import "../styles/tribuna90.css";

interface Props {
  title: string;
  volanta?: string;
  // Muestra la navegación de secciones (pública)
  showNavbar?: boolean;
  pagina?: number;
  // Descripción para buscadores y redes sociales
  descripcion?: string;
  // Páginas personales o de login: no indexar
  noindex?: boolean;
  // Datos estructurados de schema.org (lib/seo.ts: jsonLdPartido, jsonLdEquipo, ...)
  jsonLd?: unknown[];
}

const {
  title,
  volanta = "Tus partidos en tu calendario",
  showNavbar = true,
  pagina = 1,
  descripcion: descripcionCompleta = "Sincronizá los partidos de tus equipos y ligas de fútbol con tu calendario personal.",
  noindex = false,
  jsonLd = [],
} = Astro.props;

// Las descripciones con nombres de equipos y ligas pueden quedar largas: se recortan a ~160 caracteres
const descripcion = recortarDescripcion(descripcionCompleta);

// URL absoluta de la página (sin query ni barra final), a partir de PUBLIC_APP_URL
// Staging (docs/26): nada se indexa y una franja avisa que no es producción
const esStaging = Astro.locals.runtime.env.ENVIRONMENT === "staging";
const canonical = urlCanonica(Astro.locals.runtime.env.PUBLIC_APP_URL, Astro.url.pathname);
// WhatsApp, X e Instagram exigen una URL absoluta para la imagen de vista previa
const ogImagen = urlCanonica(Astro.locals.runtime.env.PUBLIC_APP_URL, "/og-image.png");

// Verificación de Search Console y Bing por meta tag (docs/29); con la de DNS no hacen falta. Nunca en staging
const verificacion = esStaging
  ? {}
  : { google: Astro.locals.runtime.env.GOOGLE_SITE_VERIFICATION?.trim(), bing: Astro.locals.runtime.env.BING_SITE_VERIFICATION?.trim() };

const user = Astro.locals.user;
const prefs = user
  ? await getPreferences(createDb(Astro.locals.runtime.env.DB), user.id)
  : { theme: "papel" as const };

const ruta = Astro.url.pathname;
const enSeccion = (...prefijos: string[]) =>
  prefijos.some((p) => ruta === p || ruta.startsWith(p + "/"));

// La navegación es pública; "Configuración" es personal y solo aparece con sesión
const secciones = showNavbar
  ? [
      { label: "Hoy", href: "/hoy", actual: enSeccion("/hoy") },
      { label: "Ligas", href: "/ligas", actual: enSeccion("/ligas", "/equipos") },
      { label: "Partidos", href: "/partidos", actual: enSeccion("/partidos") },
      { label: "Calendario", href: "/calendario", actual: enSeccion("/calendario") },
      ...(user ? [{ label: "Configuración", href: "/configuracion", actual: enSeccion("/configuracion") }] : []),
    ]
  : [];

// Sin sesión: botón de login que vuelve a la página actual (salvo en /login)
const accion =
  user || enSeccion("/login")
    ? undefined
    : { label: "Iniciar sesión", href: loginHref(ruta + Astro.url.search) };

const numero = user ? `Hola, ${primerNombre(user.name, user.email)}` : "Fixture sync";
const fecha = fechaLarga(new Date());
const fechaCorta = fechaMovil(new Date());
---

<!doctype html>
<html lang="es" data-theme={prefs.theme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={descripcion} />
    {(noindex || esStaging) && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    {verificacion.google && <meta name="google-site-verification" content={verificacion.google} />}
    {verificacion.bing && <meta name="msvalidate.01" content={verificacion.bing} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content="FISTURE" />
    <meta property="og:image" content={ogImagen} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="FISTURE: todos tus partidos en tu calendario" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImagen} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#b91309" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Resumen para modelos de lenguaje" />
    {jsonLd.length > 0 && <JsonLd datos={jsonLd} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Sin el truco media="print" + onload: la CSP no permite handlers inline. display=swap evita el texto invisible -->
    <link
      href="https://fonts.googleapis.com/css2?family=Anton&family=Barlow+Condensed:ital,wght@0,500;0,600;0,700;1,600;1,700&family=PT+Serif:ital,wght@0,400;0,700;1,400;1,700&display=swap"
      rel="stylesheet"
    />
    {!user && (
      <script is:inline set:html={SCRIPT_TEMA} />
    )}
  </head>
  <body class="tb-app">
    <a class="tb-saltar" href="#contenido">Saltar al contenido</a>
    {esStaging && (
      <div role="note" style="background:var(--tinta);color:var(--papel);text-align:center;padding:6px 16px;font:700 13px/18px var(--font-rotulo);letter-spacing:.08em;text-transform:uppercase">
        Staging · rama development · datos de prueba
      </div>
    )}
    <Cabecera volanta={volanta} numero={numero} numeroHref={user ? "/configuracion" : undefined} fecha={fecha} fechaMovil={fechaCorta} secciones={secciones} accion={accion} usuario={user ? { nombre: primerNombre(user.name, user.email), detalle: user.email } : undefined} />
    <main class="tb-main" id="contenido" tabindex="-1">
      <slot />
      <div style="margin-top:56px">
        <Folio pagina={pagina} fecha={fecha} />
      </div>
    </main>
    <footer class="tb-footer">
      <span translate="no" style="font:400 20px/1 var(--font-titular);transform:skewX(-8deg)">FISTURE</span>
      <span><a href="/ayuda" class="tb-footer__enlace">Ayuda</a> · <a href={`mailto:${CONTACTO_EMAIL}`} class="tb-footer__enlace">Contacto</a> · <a href="/privacidad" class="tb-footer__enlace">Privacidad</a> · <a href="/terminos" class="tb-footer__enlace">Condiciones</a></span>
    </footer>
  </body>
</html>
