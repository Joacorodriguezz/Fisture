---
import CalendarButton from "./islands/CalendarButton";

interface Props {
  match: {
    id: string;
    dateTime: Date | number;
    venue?: string | null;
    round?: string | null;
    status?: string | null;
    homeScore?: number | null;
    awayScore?: number | null;
  };
  homeTeam: {
    id: string;
    name: string;
    shortName?: string | null;
    logo?: string | null;
  };
  awayTeam: {
    id: string;
    name: string;
    shortName?: string | null;
    logo?: string | null;
  };
  league: {
    name: string;
  };
  provider: string;
  syncStatus?: string | null;
}

const { match, homeTeam, awayTeam, league, provider, syncStatus } = Astro.props;

const date = new Date(match.dateTime);
const formattedDate = date.toLocaleDateString("es-AR", {
  weekday: "long",
  day: "numeric",
  month: "long",
});
const formattedTime = date.toLocaleTimeString("es-AR", {
  hour: "2-digit",
  minute: "2-digit",
});

const isLive = match.status === "live";
const isFinished = match.status === "finished";
const isSynced = syncStatus === "synced";
---

<div class="card">
  <div class="flex items-center justify-between mb-4">
    <span class="badge badge-info">{league.name}</span>
    <div class="flex items-center gap-2">
      {match.round && (
        <span class="text-xs text-gray-500">{match.round}</span>
      )}
      {isLive && (
        <span class="badge bg-red-500 text-white animate-pulse">EN VIVO</span>
      )}
      {isFinished && (
        <span class="badge bg-gray-500 text-white">Finalizado</span>
      )}
    </div>
  </div>

  <div class="flex items-center justify-between mb-4">
    <div class="flex items-center gap-3 flex-1">
      <img
        src={homeTeam.logo || "/placeholder-team.svg"}
        alt={homeTeam.name}
        class="w-12 h-12 object-contain"
        loading="lazy"
      />
      <div class="min-w-0">
        <span class="font-medium block truncate">{homeTeam.name}</span>
        {homeTeam.shortName && (
          <span class="text-xs text-gray-400">{homeTeam.shortName}</span>
        )}
      </div>
    </div>

    <div class="text-center px-4">
      {isFinished || isLive ? (
        <span class="text-2xl font-bold">
          {match.homeScore ?? 0} - {match.awayScore ?? 0}
        </span>
      ) : (
        <span class="text-2xl font-bold text-gray-300">vs</span>
      )}
    </div>

    <div class="flex items-center gap-3 flex-1 justify-end">
      <div class="min-w-0 text-right">
        <span class="font-medium block truncate">{awayTeam.name}</span>
        {awayTeam.shortName && (
          <span class="text-xs text-gray-400">{awayTeam.shortName}</span>
        )}
      </div>
      <img
        src={awayTeam.logo || "/placeholder-team.svg"}
        alt={awayTeam.name}
        class="w-12 h-12 object-contain"
        loading="lazy"
      />
    </div>
  </div>

  <div class="flex items-center justify-between text-sm text-gray-600 border-t pt-4">
    <div>
      <p class="capitalize">{formattedDate}</p>
      <p class="font-medium text-gray-900">{formattedTime}</p>
      {match.venue && (
        <p class="text-xs text-gray-400 mt-1">{match.venue}</p>
      )}
    </div>

    {!isFinished && (
      <CalendarButton
        client:visible
        matchId={match.id}
        provider={provider}
        initialSynced={isSynced}
      />
    )}
  </div>
</div>
