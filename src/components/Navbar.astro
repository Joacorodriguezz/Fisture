---
interface Props {
  user: {
    id: string;
    name?: string | null;
    email: string;
    image?: string | null;
  };
}

const { user } = Astro.props;
const currentPath = Astro.url.pathname;
---

<nav class="bg-white border-b sticky top-0 z-50">
  <div class="max-w-6xl mx-auto px-4">
    <div class="flex justify-between items-center h-16">
      <a href="/equipos" class="font-bold text-xl text-primary-600">FISTURE</a>

      <div class="flex items-center gap-6">
        <a
          href="/equipos"
          class:list={[
            "hover:text-primary-600 transition",
            currentPath.startsWith("/equipos") ? "text-primary-600 font-medium" : "text-gray-600"
          ]}
        >
          Equipos
        </a>
        <a
          href="/partidos"
          class:list={[
            "hover:text-primary-600 transition",
            currentPath.startsWith("/partidos") ? "text-primary-600 font-medium" : "text-gray-600"
          ]}
        >
          Partidos
        </a>

        <div class="relative group">
          <button class="flex items-center gap-2">
            {user.image ? (
              <img src={user.image} alt="" class="w-8 h-8 rounded-full object-cover" />
            ) : (
              <div class="w-8 h-8 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-medium">
                {user.name?.charAt(0).toUpperCase() || user.email.charAt(0).toUpperCase()}
              </div>
            )}
          </button>

          <div class="absolute right-0 mt-2 w-48 bg-white rounded-lg shadow-lg border opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all">
            <div class="px-4 py-3 border-b">
              <p class="font-medium truncate">{user.name || "Usuario"}</p>
              <p class="text-sm text-gray-500 truncate">{user.email}</p>
            </div>
            <a href="/api/auth/logout" class="block px-4 py-2 hover:bg-gray-50 text-red-600">
              Cerrar sesión
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</nav>
