---
// Escudo.astro: escudo del equipo dentro de una caja. Si no hay logo, muestra las iniciales.
interface Props {
  src?: string | null;
  nombre: string;
  sigla?: string | null;
  size?: number;
  pad?: number;
}

const { src, nombre, sigla, size = 44, pad = 4 } = Astro.props;
const iniciales = (sigla || nombre).slice(0, 3).toUpperCase();
---

<span
  class="tb-escudo"
  style={`flex:none;width:${size}px;height:${size}px;background:var(--crema-sobre-oscuro);border:2px solid var(--tinta);display:flex;align-items:center;justify-content:center;padding:${pad}px;overflow:hidden`}
>
  {src ? (
    <img src={src} alt="" loading="lazy" decoding="async" style="width:100%;height:100%;object-fit:contain;display:block" />
  ) : (
    <span aria-hidden="true" style="font:400 18px/1 var(--font-titular);color:var(--on-amarillo)">{iniciales}</span>
  )}
</span>
