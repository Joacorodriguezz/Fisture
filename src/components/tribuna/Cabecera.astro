---
// Cabecera.astro: franja roja compacta y fija (docs/31 D1). Desktop: nombre, secciones, buscador y
// cuenta. Mobile: nombre y cuenta; las secciones y Buscar viven en la barra inferior (BarraInferior.astro).
interface Seccion {
  label: string;
  href: string;
  actual: boolean;
}

interface Props {
  // Volanta grande sobre la franja: solo en la portada
  volanta?: string;
  secciones?: Seccion[];
  // Con sesión: avatar con la inicial que lleva a /cuenta
  usuario?: { nombre: string };
  // Sin sesión: a dónde lleva el botón de ingreso (no se muestra en /login)
  loginHref?: string;
  // Acceso al prode en móvil, junto a la cuenta: la barra inferior ya tiene 5 destinos (docs/37 D17).
  // El ícono es un tanteador (1 | 0): la copa ya es de Ligas
  prode?: { actual: boolean };
}

const { volanta, secciones = [], usuario, loginHref, prode } = Astro.props;
---

<header class="tb-cabecera">
  {volanta && <div class="tb-cabecera__volanta">{volanta}</div>}
  <div class="tb-cabecera__cuerpo">
    <a class="tb-cabecera__nombre" href="/" translate="no" aria-label="Fisture, ir al inicio">Fisture</a>
    {secciones.length > 0 && (
      <nav class="tb-cabecera__nav" aria-label="Secciones">
        {secciones.map((s) => (
          <a href={s.href} aria-current={s.actual ? "page" : undefined}>{s.label}</a>
        ))}
      </nav>
    )}
    {secciones.length > 0 && (
      <a class="tb-cabecera__buscar" href="/equipos/buscar">
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="M15.5 15.5L21 21"></path></svg>
        Buscar equipo
      </a>
    )}
    {prode && (
      <a class="tb-cabecera__prode" href="/prode" aria-label="Prode" aria-current={prode.actual ? "page" : undefined}>
        <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" stroke-linejoin="miter"><path d="M3 6h18v12H3z M12 6v12 M7 10l1.5-1v6 M15 9h2.5v6H15z"></path></svg>
        <span class="tb-cabecera__prode-texto" aria-hidden="true">Prode</span>
      </a>
    )}
    {usuario ? (
      <a class="tb-cabecera__cuenta" href="/cuenta" aria-label={`Hola, ${usuario.nombre}. Tu cuenta`}>
        {/* La inicial va por CSS (::before): es decorativa y, como texto, rompería la regla
            label-content-name-mismatch (el nombre accesible debe contener el texto visible) */}
        <span class="tb-cabecera__avatar" aria-hidden="true" data-inicial={usuario.nombre.charAt(0).toUpperCase()}></span>
        <span class="tb-cabecera__hola" aria-hidden="true">Hola, {usuario.nombre}</span>
      </a>
    ) : (
      loginHref && (
        <a class="tb-cabecera__login" href={loginHref}>Iniciar sesión</a>
      )
    )}
  </div>
</header>
