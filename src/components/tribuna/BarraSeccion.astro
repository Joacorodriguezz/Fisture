---
// BarraSeccion.astro: franja de título de sección con un dato a la derecha
interface Props {
  tono?: "rojo" | "tinta";
  extra?: string;
}

const { tono = "rojo", extra } = Astro.props;
---

<h2 class:list={["tb-barra", `tb-barra--${tono}`]}>
  <span><slot /></span>
  {extra && <span class="tb-barra__extra">{extra}</span>}
</h2>
